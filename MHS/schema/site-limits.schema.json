{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "title": "OpenMHS site limits (operator overlay, site-limits.json)",
  "description": "An operator-owned overlay that narrows the limits of the devices at one site. It is keyed by device id, then by a capability id (whose value maps limit paths to rules) or by a parameter path (a writable resource-state field, i.e. an input of cap.device.configure.v1). The overlay is intersected with the class, binding and device-envelope limits and may only narrow them: a rule that widens any bound is rejected when the endpoint loads (the comparison needs the device manifest, so it is a load-time check, not a schema check). An overlay also fills limits declared operator_required. Every overlay rule carries at least one bound, and its source, when stated, is operator.",
  "type": "object",
  "required": ["devices"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "openmhs": { "$ref": "defs.schema.json#/$defs/specVersion" },
    "site": { "type": "string", "maxLength": 200 },
    "issued_by": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "contact": { "type": "string", "maxLength": 200 }
      }
    },
    "issued_at": { "$ref": "defs.schema.json#/$defs/rfc3339" },
    "notes": { "type": "string", "maxLength": 4000 },
    "devices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(mhs://[^\\s/]+(/[^\\s]+)+|[a-z0-9][a-z0-9_.-]{0,63})$" },
      "additionalProperties": { "$ref": "#/$defs/deviceOverlay" }
    }
  },
  "$defs": {
    "overlayRule": {
      "allOf": [
        { "$ref": "defs.schema.json#/$defs/limitRule" },
        { "anyOf": [ { "required": ["min"] }, { "required": ["max"] }, { "required": ["allowed"] } ] },
        { "properties": { "source": { "const": "operator" } } }
      ]
    },
    "deviceOverlay": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(cap|x-cap)\\.[a-z0-9_.-]+\\.v[0-9]+$": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "defs.schema.json#/$defs/limitPath" },
          "additionalProperties": { "$ref": "#/$defs/overlayRule" }
        },
        "^(?!cap\\.)[A-Za-z_][A-Za-z0-9_]*(\\[(\\*|[0-9]+)\\])*(\\.[A-Za-z_][A-Za-z0-9_]*(\\[(\\*|[0-9]+)\\])*)*$": { "$ref": "#/$defs/overlayRule" }
      }
    }
  }
}
