"""OpenMHS driver for ${package_id} (scaffolded by python3 -m mhs.driver new; edit freely).

Every Limit and Fact cites its source -- vendor_doc or upstream_code, with
ref "path/in/clone.py:LINE" at commit ${commit}.  Where no source states a
bound, write Limit.operator_required("why").  See MHS/sdk/docs/driver-authoring.md.
"""

from mhs.driver import Driver, Fact, Field, Limit, action, estop, read, write


class ${class_name}(Driver):
    device_id = "${device_id}"
    device_kind = "${device_kind}"
    mode = "${mode}"
    risk = "${risk}"
    native = "${native}"
    backends = {"hardware": ".native:connect", "fake": ".fake:Fake${class_name}"}
    tags = []
    facts = []
    safe_state = "${safe_state}"
    # R2+ hardware needs an independent hardware e-stop cited as "path:LINE" (SAFE-045), or an action
    # with safe_state=True: estop_physical_ref = "docs/manual.md:12"

    # Parameters: @read for values the device reports, @write for settings.
    @read("status", type="string", description="Status reported by the native API")
    def status(self):
        return self.native.status()

    # Actions: catalogue classes (cap=...) or extensions with an inline schema.
    @action(name="x-cap.${cap_owner}.identify.v1", description="Identify the device",
            output={"identity": Field("string")})
    def identify(self):
        return self.native.identify()

    # The native emergency stop; the runtime latches before it calls this.
    @estop
    def stop(self):
        self.native.stop()
