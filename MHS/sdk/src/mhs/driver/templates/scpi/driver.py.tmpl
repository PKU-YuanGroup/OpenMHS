"""OpenMHS driver for ${package_id} (SCPI family: configuration only).

The hardware backend connects to options["host"]/options["port"] (or
options["visa_resource"]); the fake backend is fake.py.  Every Limit and Fact
cites its source (vendor_doc or upstream_code, ref "path/in/clone.py:LINE" at
commit ${commit}).  See MHS/sdk/docs/driver-authoring.md.
"""

from mhs.driver import Action, Fact, Field, Limit, ScpiDriver


class ${class_name}(ScpiDriver):
    device_id = "${device_id}"
    device_kind = "${device_kind}"
    mode = "${mode}"
    risk = "${risk}"
    native = "${native}"
    backends = {"fake": ".fake:Fake${class_name}"}
    tags = []
    facts = []
    safe_state = "${safe_state}"
    # R2+ hardware needs an independent hardware e-stop cited as "path:LINE" (SAFE-045), or an action
    # with safe_state=True: estop_physical_ref = "docs/manual.md:12"
    idn = {"expect": "^Example,Instrument"}

    parameters = {"status": Field("string", description="Operation status condition register")}
    reads = {"status": {"query": "STAT:OPER:COND?", "parse": {"kind": "str"}}}
    commands = {"x-cap.${cap_owner}.identify.v1": {"query": "*IDN?", "parse": {"kind": "str"},
                                                  "result": {"map": {"identity": "output.$$"}}}}
    actions = {"x-cap.${cap_owner}.identify.v1": Action(name="identify", description="Identify the instrument",
                                                       output={"identity": Field("string")})}
    safety_bindings = {"estop": {"write": "OUTP OFF"}}
