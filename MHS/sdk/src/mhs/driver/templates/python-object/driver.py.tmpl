"""OpenMHS driver for ${package_id} (python-object family: configuration only).

The bridge calls the backend object's methods as declared below.  Every Limit
and Fact cites its source (vendor_doc or upstream_code, ref
"path/in/clone.py:LINE" at commit ${commit}).  See MHS/sdk/docs/driver-authoring.md.
"""

from mhs.driver import Action, Fact, Field, Limit, PythonObjectDriver


class ${class_name}(PythonObjectDriver):
    device_id = "${device_id}"
    device_kind = "${device_kind}"
    mode = "${mode}"
    risk = "${risk}"
    native = "${native}"
    backends = {"hardware": ".native:connect", "fake": ".fake:Fake${class_name}"}
    tags = []
    facts = []
    safe_state = "${safe_state}"
    # R2+ hardware needs an independent hardware e-stop cited as "path:LINE" (SAFE-045), or an action
    # with safe_state=True: estop_physical_ref = "docs/manual.md:12"

    parameters = {"status": Field("string", description="Status reported by the native API")}
    reads = {"status": {"native": "status", "invoke": "call"}}
    commands = {"x-cap.${cap_owner}.identify.v1": {"native": "identify", "concurrency": "shared", "timeout_ms": 2000,
                                                  "result": {"map": {"identity": "output.$$"}}}}
    actions = {"x-cap.${cap_owner}.identify.v1": Action(name="identify", description="Identify the device",
                                                       output={"identity": Field("string")})}
    safety_bindings = {"estop": {"native": "stop"}}
