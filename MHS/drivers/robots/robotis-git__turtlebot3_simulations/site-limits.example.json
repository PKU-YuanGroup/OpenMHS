{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example TurtleBot3 fake-node deployment (operator data, not a device fact)",
  "issued_by": {
    "id": "operator:example"
  },
  "devices": {
    "mhs://localhost/turtlebot3-sim": {
      "x-cap.robotis-git.turtlebot3_sim_cmd_vel.v1": {
        "linear_velocity": {
          "min": -0.2,
          "max": 0.2,
          "unit": "m/s",
          "source": "operator",
          "reason": "operator-selected example forward and reverse envelope"
        },
        "angular_velocity": {
          "min": -1.0,
          "max": 1.0,
          "unit": "rad/s",
          "source": "operator",
          "reason": "operator-selected example yaw-rate envelope"
        }
      }
    }
  }
}
