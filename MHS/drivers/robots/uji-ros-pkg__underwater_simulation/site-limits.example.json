{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example UWSim deployment (operator data, not a device fact)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/underwater-simulation": {
      "x-cap.uji-ros-pkg.vehicle_twist.v1": {
        "linear_x": {"min": -0.5, "max": 0.5, "unit": "m/s", "source": "operator",
                     "reason": "operator-selected example envelope for twist.linear.x"},
        "linear_y": {"min": -0.5, "max": 0.5, "unit": "m/s", "source": "operator",
                     "reason": "operator-selected example envelope for twist.linear.y"},
        "linear_z": {"min": -0.5, "max": 0.5, "unit": "m/s", "source": "operator",
                     "reason": "operator-selected example envelope for twist.linear.z"},
        "angular_x": {"min": -1.0, "max": 1.0, "unit": "rad/s", "source": "operator",
                      "reason": "operator-selected example envelope for twist.angular.x"},
        "angular_y": {"min": -1.0, "max": 1.0, "unit": "rad/s", "source": "operator",
                      "reason": "operator-selected example envelope for twist.angular.y"},
        "angular_z": {"min": -1.0, "max": 1.0, "unit": "rad/s", "source": "operator",
                      "reason": "operator-selected example envelope for twist.angular.z"}
      }
    }
  }
}
