{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (ADLINK DDSBot)",
  "issued_by": {"id": "operator:example"},
  "notes": "Example values only; the site replaces them with its own supervised envelope. They are operator bounds, not device facts.",
  "devices": {
    "mhs://localhost/adlink-ddsbot": {
      "cap.motion.mobile_base.v1": {
        "linear_velocity": {"min": -0.1, "max": 0.1, "unit": "m/s", "source": "operator",
                            "reason": "example transit speed for the supervised bench run"},
        "angular_velocity": {"min": -0.5, "max": 0.5, "unit": "rad/s", "source": "operator",
                             "reason": "example turn rate for the supervised bench run"},
        "duration_s": {"min": 0, "max": 10, "unit": "s", "source": "operator",
                       "reason": "example supervised-run maximum"}
      }
    }
  }
}
