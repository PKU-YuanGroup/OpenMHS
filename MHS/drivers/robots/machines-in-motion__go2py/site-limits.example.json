{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Go2)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/go2": {
      "x-cap.machines-in-motion.go2_body_velocity.v1": {
        "forward_velocity": {
          "min": -0.5, "max": 0.5, "unit": "m/s", "source": "operator",
          "reason": "example: the configured forward speed envelope of this deployment"
        },
        "lateral_velocity": {
          "min": -0.4, "max": 0.4, "unit": "m/s", "source": "operator",
          "reason": "example: the configured lateral speed envelope of this deployment"
        },
        "yaw_rate": {
          "min": -0.5, "max": 0.5, "unit": "rad/s", "source": "operator",
          "reason": "example: the configured yaw rate envelope of this deployment"
        }
      }
    }
  }
}
