{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Dobot V4 six-axis arm)",
  "issued_by": {
    "id": "operator:example"
  },
  "devices": {
    "mhs://localhost/dobot-arm": {
      "x-cap.dobot-arm.move_joint.v1": {
        "joint_positions": {
          "min": -3.0,
          "max": 3.0,
          "unit": "rad",
          "source": "operator",
          "reason": "example only: one bench's joint travel; the arm family's own limits differ and the operator must set them"
        }
      },
      "x-cap.dobot-arm.move_pose.v1": {
        "position.x": {
          "min": -200,
          "max": 800,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: a cell envelope for one bench"
        },
        "position.y": {
          "min": -400,
          "max": 400,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: a cell envelope for one bench"
        },
        "position.z": {
          "min": 0,
          "max": 700,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: above the table"
        },
        "orientation.roll": {
          "min": -3.0,
          "max": 3.0,
          "unit": "rad",
          "source": "operator",
          "reason": "example only: the wrist range for one tool"
        },
        "orientation.pitch": {
          "min": -3.0,
          "max": 3.0,
          "unit": "rad",
          "source": "operator",
          "reason": "example only: the wrist range for one tool"
        },
        "orientation.yaw": {
          "min": -3.0,
          "max": 3.0,
          "unit": "rad",
          "source": "operator",
          "reason": "example only: the wrist range for one tool"
        }
      }
    }
  }
}
