{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Dobot V4 arm)",
  "issued_by": {
    "id": "operator:example"
  },
  "devices": {
    "mhs://localhost/dobot-arm": {
      "cap.motion.joint_position.v1": {
        "joint_positions": {
          "min": -2.96706,
          "max": 2.96706,
          "unit": "rad",
          "source": "operator",
          "reason": "example: a 170 degree joint envelope for one bench (the same for every joint); the site sets the arm's own travel"
        }
      },
      "cap.motion.cartesian_pose.v1": {
        "position.x": {
          "min": -200,
          "max": 800,
          "unit": "mm",
          "source": "operator",
          "reason": "example: cell wall"
        },
        "position.y": {
          "min": -400,
          "max": 400,
          "unit": "mm",
          "source": "operator",
          "reason": "example: cell wall"
        },
        "position.z": {
          "min": 0,
          "max": 700,
          "unit": "mm",
          "source": "operator",
          "reason": "example: above the table"
        },
        "orientation.roll": {
          "min": -3.1416,
          "max": 3.1416,
          "unit": "rad",
          "source": "operator",
          "reason": "example: wrist range"
        },
        "orientation.pitch": {
          "min": -3.1416,
          "max": 3.1416,
          "unit": "rad",
          "source": "operator",
          "reason": "example: wrist range"
        },
        "orientation.yaw": {
          "min": -3.1416,
          "max": 3.1416,
          "unit": "rad",
          "source": "operator",
          "reason": "example: wrist range"
        }
      }
    }
  }
}
