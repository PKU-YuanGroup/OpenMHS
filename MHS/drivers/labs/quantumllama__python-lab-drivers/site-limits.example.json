{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Siglent SDG 2042X)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/sdg2042x": {
      "duty_cycle": {"min": 0, "max": 50, "unit": "%", "source": "operator",
                     "reason": "example: this bench uses square waves at 50 percent duty or less"},
      "waveform": {"allowed": ["SQUARE"], "source": "operator",
                   "reason": "example: this bench only needs the square waveform"}
    }
  }
}
