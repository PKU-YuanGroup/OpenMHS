{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example sdl-simulation deployment (operator data, not a device fact)",
  "issued_by": {"id": "operator:example"},
  "notes": "Example only. The clone states no workspace, navigation or gripper envelope; these values are operator-selected examples and must never be read as upstream facts.",
  "devices": {
    "mhs://localhost/sdl-simulation": {
      "x-cap.ad-sdl.arm_pose_goal.v1": {
        "x": {"min": 0.0, "max": 2.0, "unit": "m", "source": "operator", "reason": "example arm workspace x"},
        "y": {"min": -2.0, "max": 2.0, "unit": "m", "source": "operator", "reason": "example arm workspace y"},
        "z": {"min": 0.0, "max": 2.0, "unit": "m", "source": "operator", "reason": "example arm workspace z"},
        "qx": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qy": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qz": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qw": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"}
      },
      "x-cap.ad-sdl.base_pose_goal.v1": {
        "x": {"min": -5.0, "max": 5.0, "unit": "m", "source": "operator", "reason": "example map-frame goal x"},
        "y": {"min": -5.0, "max": 5.0, "unit": "m", "source": "operator", "reason": "example map-frame goal y"},
        "z": {"min": 0.0, "max": 0.0, "unit": "m", "source": "operator", "reason": "example map-frame goal z"},
        "qx": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qy": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qz": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"},
        "qw": {"min": -1.0, "max": 1.0, "unit": "1", "source": "operator", "reason": "example quaternion component"}
      },
      "x-cap.ad-sdl.left_gripper_position.v1": {
        "position": {"min": -1.0, "max": 2.0, "unit": "1", "source": "operator",
                     "reason": "example left gripper stroke envelope"}
      },
      "x-cap.ad-sdl.right_gripper_position.v1": {
        "position": {"min": -1.0, "max": 2.0, "unit": "1", "source": "operator",
                     "reason": "example right gripper stroke envelope"}
      }
    }
  }
