{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (CubOS GRBL gantry)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/cubos-gantry": {
      "cap.motion.cartesian_pose.v1": {
        "position.x": {
          "min": 0,
          "max": 800,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: the site sets the X envelope from its calibrated working_volume"
        },
        "position.y": {
          "min": 0,
          "max": 600,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: the site sets the Y envelope from its calibrated working_volume"
        },
        "position.z": {
          "min": 0,
          "max": 300,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: the site sets the Z envelope from its calibrated working_volume"
        }
      }
    }
  }
}
