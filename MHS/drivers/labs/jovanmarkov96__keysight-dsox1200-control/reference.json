c/keysight_dsox1200/models.py:30-34","source":"upstream_code"},"name":"acquire_type","resource":"main","risk":"R1","type":"string"}],"device":{"id":"mhs://localhost/keysight-dsox1200","kind":"instrument","mode":"hardware","model":"InfiniiVision 1200 X-Series oscilloscope","name":"Keysight InfiniiVision 1200 X-Series oscilloscope (keysight_dsox1200.DSOX1200)","risk":"R1","upstream":{"commit":"34ba50a758b9f4e8773dee788c3f9a4c04455f8f","repo":"https://github.com/jovanmarkov96/keysight-dsox1200-control"},"vendor":"Keysight Technologies"},"facts":[{"ref":"src/keysight_dsox1200/instrument.py:3","reviewed_by":null,"source":"upstream_code","text":"The clone supports the DSOX1202A/G, DSOX1204A/G and EDUX1052A/G oscilloscopes"},{"ref":"src/keysight_dsox1200/instrument.py:86-91","reviewed_by":null,"source":"upstream_code","text":"The connection is a VISA resource opened by pyvisa with a newline read and write terminator"},{"ref":"src/keysight_dsox1200/instrument.py:165-167","reviewed_by":null,"source":"upstream_code","text":"identify queries *IDN? and returns the stripped identity string"},{"ref":"src/keysight_dsox1200/instrument.py:169-172","reviewed_by":null,"source":"upstream_code","text":"reset sends *RST and waits 0.5 s"},{"ref":"src/keysight_dsox1200/instrument.py:215-225","reviewed_by":null,"source":"upstream_code","text":"run, stop and single send :RUN, :STOP and :SINGle; the stop docstring says it halts acquisitions"},{"ref":"src/keysight_dsox1200/instrument.py:46-54","reviewed_by":null,"source":"upstream_code","text":"A channel number must be one of 1, 2, 3 and 4; another value raises ValidationError"},{"ref":"src/keysight_dsox1200/instrument.py:319-354","reviewed_by":null,"source":"upstream_code","text":"configure_channel sets the channel display, coupling, probe, range, scale, offset, invert, label, bandwidth limit and unit"},{"ref":"src/keysight_dsox1200/instrument.py:273-289","reviewed_by":null,"source":"upstream_code","text":"channel_scale takes volts per division, channel_range takes the full-scale voltage and channel_offset takes volts"},{"ref":"src/keysight_dsox1200/instrument.py:373-385","reviewed_by":null,"source":"upstream_code","text":"timebase_scale takes seconds per division and timebase_position takes seconds"},{"ref":"src/keysight_dsox1200/instrument.py:466-479","reviewed_by":null,"source":"upstream_code","text":"configure_trigger_edge sets the source, level in volts, slope, sweep and coupling"},{"ref":"src/keysight_dsox1200/instrument.py:496-498","reviewed_by":null,"source":"upstream_code","text":"acquire_count sets the number of averages, 2 to 65536, when the acquisition type is AVERage"},{"ref":"src/keysight_dsox1200/instrument.py:510-512","reviewed_by":null,"source":"upstream_code","text":"acquire_srate_query reads the sample rate the scope derives from the timebase"},{"ref":"src/keysight_dsox1200/instrument.py:514-516","reviewed_by":null,"source":"upstream_code","text":"acquire_complete returns the percentage of required waveforms acquired"},{"ref":"src/keysight_dsox1200/instrument.py:644-704","reviewed_by":null,"source":"upstream_code","text":"The automatic measurements query :MEASure:<item>? and return a float; measure_counter is the hardware counter frequency measurement"},{"ref":"src/keysight_dsox1200/instrument.py:551-608","reviewed_by":null,"source":"upstream_code","text":"capture_waveform transfers :WAVeform:DATA? as a binary block and returns time and voltage arrays"},{"ref":"src/keysight_dsox1200/models.py:13-72","reviewed_by":null,"source":"upstream_code","text":"The enums carry the exact SCPI spellings used by the setters: coupling, acquire type, trigger sweep, trigger slope, trigger source and timebase mode"}],"measures":[{"description":"Instrument identity (*IDN?)","name":"identity","resource":"main","type":"string"},{"description":"Channel 1 probe attenuation ratio","name":"channel1_probe_ratio","resource":"main","type":"number","unit":"1"},{"description":"Channel 1 waveform inverted","name":"channel1_invert","resource":"main","type":"boolean"},{"description":"Timebase mode","name":"timebase_mode","resource":"main","type":"string"},{"description":"Timebase position in seconds","name":"timebase_position_s","resource":"main","type":"number","unit":"s"},{"description":"Edge-trigger slope","name":"trigger_slope","resource":"main","type":"string"},{"description":"Trigger sweep mode","name":"trigger_sweep","resource":"main","type":"string"},{"description":"Number of averages for AVERage acquisition","name":"acquire_count","resource":"main","type":"integer","unit":"1"},{"description":"Data points acquired per waveform","name":"acquire_points","resource":"main","type":"integer","unit":"1"},{"description":"Sample rate derived from the timebase","name":"sample_rate_hz","resource":"main","type":"number","unit":"Hz"},{"description":"Percentage of required waveforms acquired","name":"acquire_complete","resource":"main","type":"integer","unit":"1"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB1-038"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:67a7f0b3d8befd8c3e6e5272fa3d2f7543938438e8df7451df3bcba84cfa6835","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"stop"},"interlocks":[],"not_certified":true,"operator_required":[{"name":"channel1_scale_v_per_div","reason":"the clone states only the 8 x V/div full-scale formula, not a per-division range; the range depends on the probe ratio and the model (instrument.py:273-282)"},{"name":"channel1_offset_v","reason":"the clone states no offset range; it depends on the vertical scale and the probe ratio (instrument.py:287-289)"},{"name":"timebase_scale_s_per_div","reason":"the clone states no timebase range; it depends on the model and the timebase mode (instrument.py:373-378)"},{"name":"trigger_level_v","reason":"the clone states no trigger level bound; it depends on the trigger source range (instrument.py:456-460)"}],"safe_state":{"achieved_by":["x-cap.jovanmarkov96.stop_acquisition.v1"],"description":"acquisition stopped with :STOP; the frozen display is the safe state of the oscilloscope"}},"tags":["oscilloscope","keysight","infiniivision","dsox1200","edux1052","scpi","visa"]}
