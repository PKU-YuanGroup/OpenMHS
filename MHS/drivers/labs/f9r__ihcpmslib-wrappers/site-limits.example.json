{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (INHECO SCILA)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/scila": {
      "cap.thermal.setpoint.v1": {
        "target_temperature": {"min": 20, "max": 40, "unit": "Cel", "source": "operator",
                               "reason": "example: the cell culture in this incubator tolerates 20 to 40 Cel"}
      }
    }
  }
}
