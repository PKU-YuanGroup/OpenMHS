{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (IKA RET Control Visc)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/ika-ret-control-visc": {
      "temperature_setpoint": {"min": 20, "max": 200, "unit": "Cel", "source": "operator",
                               "reason": "example: the example vessel and sample tolerate 20 to 200 Cel"},
      "stir_rate_setpoint": {"min": 50, "max": 1200, "unit": "/min", "source": "operator",
                             "reason": "example: the example vessel tolerates 50 to 1200 rpm"},
      "cap.thermal.setpoint.v1": {
        "target_temperature": {"min": 20, "max": 200, "unit": "Cel", "source": "operator",
                               "reason": "example: the same range as the temperature_setpoint field"}
      }
    }
  }
}
