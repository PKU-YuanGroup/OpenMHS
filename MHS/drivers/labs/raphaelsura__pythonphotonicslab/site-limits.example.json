{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (DG645 deployment example)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/dg645": {
      "amplitude": {"min": 0, "max": 5, "unit": "1", "source": "operator",
                    "reason": "example"},
      "offset": {"min": -5, "max": 5, "unit": "1", "source": "operator",
                 "reason": "example"},
      "polarity": {"allowed": [0, 1], "unit": "1", "source": "operator",
                   "reason": "example"},
      "delay": {"min": 0, "max": 1, "unit": "s", "source": "operator",
                "reason": "example"},
      "holdoff": {"min": 0, "max": 1, "unit": "s", "source": "operator",
                  "reason": "example"},
      "trigger_level": {"min": 0, "max": 5, "unit": "1", "source": "operator",
                        "reason": "example"},
      "trigger_rate": {"min": 0, "max": 1000000, "unit": "Hz", "source": "operator",
                       "reason": "example"},
      "burst_count": {"min": 1, "max": 1000, "unit": "1", "source": "operator",
                      "reason": "example"},
      "burst_delay": {"min": 0, "max": 1, "unit": "s", "source": "operator",
                      "reason": "example"},
      "burst_mode": {"min": 0, "max": 3, "unit": "1", "source": "operator",
                     "reason": "example"},
      "burst_period": {"min": 0.000001, "max": 1, "unit": "s", "source": "operator",
                       "reason": "example"},
      "burst_config": {"min": 0, "max": 3, "unit": "1", "source": "operator",
                       "reason": "example"}
    }
  }
}
