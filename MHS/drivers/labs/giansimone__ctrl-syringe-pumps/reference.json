{"$schema":"https://mhs.openai4s.org/schema/0.9/reference.schema.json","actions":[{"cancellable":false,"cap_id":"x-cap.giansimone.run_pump.v1","description":"Start the pump (RUN)","inputs":[],"long_running":false,"name":"run_pump","outputs":[{"description":"Reply line the pump returned to RUN","name":"reply","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R2","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.giansimone.stop_pump.v1","description":"Stop the pump (STP); the safe-state action","inputs":[],"long_running":false,"name":"stop_pump","outputs":[{"description":"Reply line the pump returned to STP","name":"reply","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R2","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.giansimone.test_pump.v1","description":"Send the version/test command (VER)","inputs":[],"long_running":false,"name":"test_pump","outputs":[{"description":"Reply line the pump returned to VER","name":"reply","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R2","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.giansimone.reverse_direction.v1","description":"Reverse the flow for the selected pump (DIR REV)","inputs":[],"long_running":false,"name":"reverse_direction","outputs":[{"description":"Reply line the pump returned to DIR REV","name":"reply","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R2","status":"extension","verb":"invoke"}],"adjusts":[{"description":"Inside diameter of the syringe (DIA)","limit":{"max":50,"min":0.1,"reason":"DIAMETER_RANGE is [0.1, 50.0]","ref":"ctrl_syringe_pumps/interface.py:10","source":"upstream_code","unit":"mm"},"name":"diameter","resource":"main","risk":"R2","type":"number","unit":"mm"},{"description":"Pumping direction token: INF to infuse, WDR to withdraw (DIR INF/DIR WDR)","enum":["INF","WDR"],"limit":{"allowed":["INF","WDR"],"reason":"the clone sends DIR INF and DIR WDR; DIR REV is the separate reverse action","ref":"ctrl_syringe_pumps/interface.py:46-58","source":"upstream_code"},"name":"direction","resource":"main","risk":"R2","type":"string"},{"description":"Pumping rate as one RAT command: the numeric value and the rate-unit token","name":"pumping_rate","resource":"main","risk":"R2","type":"object"}],"device":{"id":"mhs://localhost/syringe-pump","kind":"fluid.pump","mode":"hardware","model":"Serial syringe pump (basic mode)","name":"Syringe pump over serial (ctrl-syringe-pumps)","risk":"R2","upstream":{"commit":"3b0d3154003498f65150d8f04905f3a27cdd9017","repo":"https://github.com/giansimone/ctrl-syringe-pumps"},"vendor":"giansimone"},"facts":[{"ref":"ctrl_syringe_pumps/control.py:33","reviewed_by":null,"source":"upstream_code","text":"A command line is the address string, the command text and a carriage return"},{"ref":"ctrl_syringe_pumps/interface.py:17","reviewed_by":null,"source":"upstream_code","text":"The pump address is written as a zero-padded two-digit number before the command"},{"ref":"ctrl_syringe_pumps/interface.py:4-6","reviewed_by":null,"source":"upstream_code","text":"The two default pump addresses are 0 and 1"},{"ref":"ctrl_syringe_pumps/interface.py:10","reviewed_by":null,"source":"upstream_code","text":"DIAMETER_RANGE is [0.1, 50.0]"},{"ref":"ctrl_syringe_pumps/interface.py:43","reviewed_by":null,"source":"upstream_code","text":"The diameter unit is millimetres"},{"ref":"ctrl_syringe_pumps/interface.py:39-43","reviewed_by":null,"source":"upstream_code","text":"set_diameter sends 'DIA <value>' and accepts only 0.1 < value < 50.0, so the endpoints are rejected"},{"ref":"ctrl_syringe_pumps/interface.py:8","reviewed_by":null,"source":"upstream_code","text":"RATE_UNITS is ['UM', 'MM', 'UH', 'MH']"},{"ref":"ctrl_syringe_pumps/interface.py:61-66","reviewed_by":null,"source":"upstream_code","text":"set_pumping_rate sends 'RAT <value> <rate_unit>' as one command"},{"ref":"ctrl_syringe_pumps/interface.py:46-58","reviewed_by":null,"source":"upstream_code","text":"The infuse direction is 'DIR INF', withdraw is 'DIR WDR' and reverse is 'DIR REV'"},{"ref":"ctrl_syringe_pumps/interface.py:68-76","reviewed_by":null,"source":"upstream_code","text":"The pump is started with 'RUN' and stopped with 'STP'"},{"ref":"ctrl_syringe_pumps/interface.py:31-34","reviewed_by":null,"source":"upstream_code","text":"The version/test command is 'VER'"},{"ref":"ctrl_syringe_pumps/control.py:7-11","reviewed_by":null,"source":"upstream_code","text":"The serial defaults are 9600 baud and a 0.5 s timeout"},{"ref":"ctrl_syringe_pumps/control.py:35-43","reviewed_by":null,"source":"upstream_code","text":"The serial frame is eight data bits with no parity"}],"measures":[],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB1-007"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:8f9cd39fbd9e7daf1b3ed0ed9de0f527007c9b7b3371b88d23171f160b2f358f","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"stop"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":["x-cap.giansimone.stop_pump.v1"],"description":"pump stopped with STP"}},"tags":["syringe pump","serial","infuse","withdraw","pump"]}
