{"$schema":"https://openmhs.invalid/schema/0.9/reference.schema.json","actions":[],"adjusts":[{"description":"Output frequency (FREQ)","limit":{"max":10000000,"min":0.001,"reason":"set_frequency accepts min_freq = 1e-3 Hz (line 29) through max_freq = 10e6 Hz (line 30)","ref":"instruments/keysight33210A.py:29-30","source":"upstream_code","unit":"Hz"},"name":"frequency","resource":"main","risk":"R1","type":"number","unit":"Hz"},{"description":"Output amplitude in the selected voltage unit (VOLT)","limit":"operator_required","name":"amplitude","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"DC offset in volts (VOLT:OFFS)","limit":"operator_required","name":"offset","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Waveform function (FUNC)","limit":{"allowed":["SIN","SQU","RAMP","PULS","NOIS","DC","USER"],"ref":"instruments/keysight33210A.py:20","source":"upstream_code"},"name":"function","resource":"main","risk":"R1","type":"string"},{"description":"Output termination (OUTP:LOAD): '50' for 50 ohm or 'INF' for high impedance","limit":{"allowed":["50","INF"],"ref":"instruments/keysight33210A.py:36","source":"upstream_code"},"name":"load","resource":"main","risk":"R1","type":"string"},{"description":"Output relay state (OUTP): ON or OFF","limit":{"allowed":["ON","OFF"],"ref":"instruments/keysight33210A.py:171-176","source":"upstream_code"},"name":"output","resource":"main","risk":"R1","type":"string"}],"device":{"id":"mhs://localhost/keysight33210a","kind":"instrument","mode":"hardware","model":"33210A function generator","name":"Keysight 33210A function generator","risk":"R1","upstream":{"commit":"631eb6fe6e61ca83e0d065aa3e36b04244c952b4","repo":"https://github.com/jrafolsr/pyinstruments"},"vendor":"Keysight / Agilent Technologies"},"facts":[{"ref":"instruments/keysight33210A.py:16","reviewed_by":null,"source":"upstream_code","text":"The class requires the identity string to start with 'Agilent Technologies'"},{"ref":"instruments/keysight33210A.py:20","reviewed_by":null,"source":"upstream_code","text":"The waveform functions are SIN, SQU, RAMP, PULS, NOIS, DC and USER"},{"ref":"instruments/keysight33210A.py:29-30","reviewed_by":null,"source":"upstream_code","text":"The frequency setter accepts 1e-3 Hz to 10e6 Hz"},{"ref":"instruments/keysight33210A.py:36","reviewed_by":null,"source":"upstream_code","text":"The load setter accepts 50 ohm or the string 'INF'"},{"ref":"instruments/keysight33210A.py:95-96","reviewed_by":null,"source":"upstream_code","text":"The amplitude setter rejects amplitude <= 0"},{"ref":"instruments/keysight33210A.py:34-47","reviewed_by":null,"source":"upstream_code","text":"The load-dependent Vmax is 5 V for 50 ohm and 10 V for INF"},{"ref":"instruments/keysight33210A.py:134-138","reviewed_by":null,"source":"upstream_code","text":"The offset setter refuses |offset| > Vmax - Vpp/2 with the load-dependent Vmax"},{"ref":"instruments/keysight33210A.py:171-176","reviewed_by":null,"source":"upstream_code","text":"The output relay commands are ':OUTP OFF' and ':OUTP ON'"},{"ref":"instruments/keysight33210A.py:69","reviewed_by":null,"source":"upstream_code","text":"FUNC? reads the current waveform function"},{"ref":"instruments/keysight33210A.py:105","reviewed_by":null,"source":"upstream_code","text":":OUTP:LOAD? reads the output termination"},{"ref":"instruments/keysight33210A.py:128","reviewed_by":null,"source":"upstream_code","text":"VOLT? reads the current amplitude"},{"ref":"instruments/keysight33210A.py:87","reviewed_by":null,"source":"upstream_code","text":"A setting is sent as 'COMMAND value', for example 'FREQ {frequency:.4e}'"},{"ref":"instruments/keysight33210A.py:142","reviewed_by":null,"source":"upstream_code","text":"The offset command is 'VOLT:OFFS {offset:.4f}V'"},{"ref":"instruments/keysight33210A.py:148-153","reviewed_by":null,"source":"upstream_code","text":"The duty cycle setter accepts 20 to 80 percent and only when the function is SQU"},{"ref":"instruments/keysight33210A.py:163-168","reviewed_by":null,"source":"upstream_code","text":"The DC voltage setter writes FUNC DC then VOLT:OFFS and bounds the value by the current Vmax"}],"measures":[],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB2-121"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:aff125d934926d389335a92cbd0f5308d3487313b412604f6c8eec72a866558c","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":":OUTP OFF"},"interlocks":[],"not_certified":true,"operator_required":[{"name":"amplitude","reason":"the upstream setter only rejects amplitude <= 0; the maximum depends on the load and the output configuration, so the site sets the range"},{"name":"offset","reason":"the upstream bound depends on the current amplitude and the load-dependent Vmax (|offset| <= Vmax - Vpp/2); the site sets the range"}],"safe_state":{"achieved_by":[],"description":"output relay off with ':OUTP OFF'"}},"tags":["function generator","keysight","agilent","33210a","scpi"]}
