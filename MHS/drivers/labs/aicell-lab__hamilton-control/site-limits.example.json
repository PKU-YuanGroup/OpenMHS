{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (PyLabRobot Incubator front end)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/hamilton-control-incubator": {
      "cap.thermal.setpoint.v1": {
        "target_temperature": {
          "min": 4,
          "max": 40,
          "unit": "Cel",
          "source": "operator",
          "reason": "example only: the incubator on this bench is used between 4 and 40 Cel; replace with the installed unit and sample limits"
        }
      },
      "x-cap.aicell-lab.start_shaking.v1": {
        "frequency": {
          "min": 0.1,
          "max": 5,
          "unit": "Hz",
          "source": "operator",
          "reason": "example only: the shaker on this bench is used between 0.1 and 5 Hz; replace with the installed unit"
        }
      }
    }
  }
}
