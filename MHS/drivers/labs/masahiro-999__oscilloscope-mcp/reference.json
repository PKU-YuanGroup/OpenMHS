{"$schema":"https://mhs.openai4s.org/schema/0.9/reference.schema.json","actions":[{"cancellable":false,"cap_id":"x-cap.masahiro-999.measure.v1","description":"Read the scope-side automatic measurements for one or more items on a channel","inputs":[{"description":"Automatic measurement items to query","items_type":"string","name":"items","required":true,"type":"array"},{"description":"Primary channel the measurements are taken on","enum":["CHAN1","CHAN2","CHAN3","CHAN4"],"name":"source","required":false,"type":"string"},{"description":"Second channel for the two-source delay and phase items","enum":["CHAN1","CHAN2","CHAN3","CHAN4"],"name":"source2","required":false,"type":"string"}],"long_running":false,"name":"measure","outputs":[{"description":"Measured value per canonical item name; null when unmeasurable","name":"values","required":true,"type":"object"},{"description":"Primary channel the measurements were taken on","name":"source","required":true,"type":"string"},{"description":"Second channel used for two-source items, or null","name":"source2","required":true,"type":"string"},{"description":"Items queried, in request order","items_type":"string","name":"items","required":true,"type":"array"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.masahiro-999.run_control.v1","description":"Start, stop, arm a single acquisition, or force a trigger","inputs":[{"description":"Run control action to apply","enum":["RUN","STOP","SINGLE","FORCE"],"name":"action","required":true,"type":"string"}],"long_running":false,"name":"run_control","outputs":[{"description":"Canonical action the scope applied","name":"action","required":true,"type":"string"},{"description":"Trigger status after the action (:TRIG:STAT?)","name":"status","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"}],"adjusts":[{"description":"CH1 vertical scale in volts per division","limit":{"max":100,"min":0.001,"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:65","source":"upstream_code","unit":"V"},"name":"channel_1_scale","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH1 vertical offset in volts","limit":{"max":100,"min":-100,"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:66","source":"upstream_code","unit":"V"},"name":"channel_1_offset","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH1 probe attenuation ratio","limit":{"allowed":[0.01,0.02,0.05,0.1,0.2,0.5,1,2,5,10,20,50,100,200,500,1000],"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:62","source":"upstream_code","unit":"1"},"name":"channel_1_probe","resource":"main","risk":"R1","type":"number","unit":"1"},{"description":"CH1 input coupling","enum":["AC","DC","GND"],"name":"channel_1_coupling","resource":"main","risk":"R1","type":"string"},{"description":"Display CH1 on or off","name":"channel_1_display","resource":"main","risk":"R1","type":"boolean"},{"description":"Main timebase scale in seconds per division","limit":{"max":50,"min":5e-9,"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:69","source":"upstream_code","unit":"s"},"name":"timebase_scale","resource":"main","risk":"R1","type":"number","unit":"s"},{"description":"Main timebase offset in seconds","limit":{"max":100,"min":-100,"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:70","source":"upstream_code","unit":"s"},"name":"timebase_offset","resource":"main","risk":"R1","type":"number","unit":"s"},{"description":"Timebase mode","enum":["MAIN","XY","ROLL"],"name":"timebase_mode","resource":"main","risk":"R1","type":"string"},{"description":"Acquisition type","enum":["NORMal","AVERages","PEAK","HRESolution"],"name":"acquire_type","resource":"main","risk":"R1","type":"string"},{"description":"Averaging count","limit":{"allowed":[2,4,8,16,32,64,128,256,512,1024],"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:73","source":"upstream_code","unit":"1"},"name":"acquire_averages","resource":"main","risk":"R1","type":"integer","unit":"1"},{"description":"Trigger sweep mode","enum":["AUTO","NORMAL","SINGLE"],"name":"trigger_sweep","resource":"main","risk":"R1","type":"string"},{"description":"Trigger coupling","enum":["AC","DC","LFReject","HFReject"],"name":"trigger_coupling","resource":"main","risk":"R1","type":"string"}],"device":{"id":"mhs://localhost/rigol-ds1000z","kind":"instrument","mode":"hardware","model":"DS1000Z series (DS1054Z / DS1074Z / DS1104Z)","name":"RIGOL DS1000Z-series oscilloscope (RigolDs1000z)","risk":"R1","upstream":{"commit":"e45773551e2b956e1fb086ad99cbfec546eaad4b","repo":"https://github.com/masahiro-999/oscilloscope-mcp"},"vendor":"RIGOL"},"facts":[{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:1-6","reviewed_by":null,"source":"upstream_code","text":"The DS1000Z module drives the DS1054Z, DS1074Z and DS1104Z over line-based SCPI on raw TCP port 5555"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:54-55","reviewed_by":null,"source":"upstream_code","text":"RigolDs1000z implements the Scope interface for every DS1000Z-series scope"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:104-116","reviewed_by":null,"source":"upstream_code","text":"get_channel reads scale, offset, coupling, display, probe, bandwidth limit, invert and units for one channel"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:118-145","reviewed_by":null,"source":"upstream_code","text":"set_channel validates every requested field before sending one burst, with the probe ratio first"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:147-152","reviewed_by":null,"source":"upstream_code","text":"get_timebase reads :TIM:MAIN:SCAL?, :TIM:MAIN:OFFS? and :TIM:MODE?"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:154-168","reviewed_by":null,"source":"upstream_code","text":"set_timebase validates the mode, scale and offset before sending one burst"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:174-188","reviewed_by":null,"source":"upstream_code","text":"get_acquire reads :ACQ:TYPE?, :ACQ:AVER?, :ACQ:MDEP? and :ACQ:SRAT?"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:190-206","reviewed_by":null,"source":"upstream_code","text":"set_acquire validates every requested field before sending one burst"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:212-236","reviewed_by":null,"source":"upstream_code","text":"get_trigger reads the global trigger fields and every readable parameter of the current trigger mode"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:238-280","reviewed_by":null,"source":"upstream_code","text":"set_trigger validates all parameters up front and sends them in one burst with the mode first"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:282-287","reviewed_by":null,"source":"upstream_code","text":"run_control writes the root command the profile maps to RUN, STOP, SINGLE or FORCE"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:293-333","reviewed_by":null,"source":"upstream_code","text":"measure validates the measurement items and sources before querying :MEAS:ITEM? per item"},{"ref":"src/oscilloscope_mcp/instruments/rigol_ds1000z.py:399-404","reviewed_by":null,"source":"upstream_code","text":"read_waveform reads about 1200 screen points in NORMal mode and up to 24M acquisition points in RAW mode, which requires the scope to be stopped"},{"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:65-66","reviewed_by":null,"source":"upstream_code","text":"The vertical scale range is 1.0e-3 to 100.0 V/div and the vertical offset range is -100.0 to 100.0 V"},{"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:69-70","reviewed_by":null,"source":"upstream_code","text":"The timebase scale range is 5.0e-9 to 50 s/div and the timebase offset range is -100.0 to 100.0 s"},{"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:62","reviewed_by":null,"source":"upstream_code","text":"The channel probe ratios are the 16 declared ratios from 0.01 to 1000"},{"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:73","reviewed_by":null,"source":"upstream_code","text":"The averaging counts are the powers of two from 2 to 1024"},{"ref":"src/oscilloscope_mcp/instruments/profiles/_ds1000z_family.yaml:61-80","reviewed_by":null,"source":"upstream_code","text":"The profile declares channel coupling AC/DC/GND, timebase modes MAIN/XY/ROLL, acquire types NORMal/AVERages/PEAK/HRESolution, trigger sweeps AUTO/NORMAL/SINGLE and trigger couplings AC/DC/LFReject/HFReject"},{"ref":"src/oscilloscope_mcp/instruments/profiles/rigol_ds1104z.yaml:14-21","reviewed_by":null,"source":"upstream_code","text":"The DS1104Z has four analog channels and 24 Mpts of acquisition memory"}],"measures":[{"description":"Response to *IDN?: vendor, model, serial and firmware","name":"identity","resource":"main","type":"string"},{"description":"Number of analog channels currently displayed","name":"active_channel_count","resource":"main","type":"integer"},{"description":"Memory depth: AUTO or a point count","name":"acquire_memory_depth","resource":"main","type":"string"},{"description":"Current sample rate in samples per second","name":"acquire_sample_rate","resource":"main","type":"number","unit":"Hz"},{"description":"Current trigger mode keyword","name":"trigger_mode","resource":"main","type":"string"},{"description":"Trigger status from :TRIG:STAT? (TD, WAIT, RUN, AUTO or STOP)","name":"trigger_status","resource":"main","type":"string"},{"description":"Trigger holdoff in seconds","name":"trigger_holdoff","resource":"main","type":"number","unit":"s"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_i