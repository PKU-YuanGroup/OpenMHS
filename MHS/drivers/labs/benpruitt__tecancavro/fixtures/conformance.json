{
  "probe": "cap.device.configure.v1",
  "capabilities": {
    "cap.device.configure.v1": {
      "valid": {"start_speed": 200, "top_speed": 2000, "cutoff_speed": 1000,
                "speed_code": 8, "slope": 10, "microstep": false},
      "alternate": {"start_speed": 150, "top_speed": 1500, "cutoff_speed": 900,
                    "speed_code": 10, "slope": 12, "microstep": true}
    },
    "x-cap.benpruitt.move_plunger.v1": {
      "valid": {"position": 1500},
      "alternate": {"position": 1200},
      "out_of_envelope": [{"position": -1}, {"position": 3001}]
    },
    "x-cap.benpruitt.dispense.v1": {
      "valid": {"port": 2, "volume": 200},
      "alternate": {"port": 3, "volume": 250},
      "out_of_envelope": [{"port": 0, "volume": 200}, {"port": 10, "volume": 200},
                          {"port": 2, "volume": -1}, {"port": 2, "volume": 1001}]
    }
  }
}
