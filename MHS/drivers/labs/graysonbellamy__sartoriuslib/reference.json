{"$schema":"https://openmhs.invalid/schema/0.9/reference.schema.json","actions":[{"cancellable":false,"cap_id":"cap.measure.mass.v1","description":"Measure the mass on a balance or load cell and report the value and stability flag.","inputs":[{"description":"Which reading to return: net (default), gross or tare","limit":{"allowed":["net","gross","tare"],"ref":"src/sartoriuslib/devices/balance.py:408-436","source":"upstream_code"},"name":"channel","required":false,"type":"string"},{"description":"If true, a reading that is not stable is refused; the facade has no settle primitive to wait on","name":"settle","required":false,"type":"boolean"}],"long_running":false,"name":"measure_mass","outputs":[{"name":"mass","required":true,"type":"number","unit":"mg"},{"name":"stable","required":true,"type":"boolean"},{"name":"sampled_at","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R1","status":"stable","verb":"read"}],"adjusts":[{"description":"Display unit p07","limit":{"allowed":["g","kg","mg","µg"],"ref":"src/sartoriuslib/registry/units.py:36-93","source":"upstream_code"},"name":"display_unit","resource":"main","risk":"R1","type":"string"},{"description":"Filter/ambient mode p01","limit":{"allowed":["very_stable","stable","unstable","very_unstable"],"ref":"src/sartoriuslib/registry/modes.py:41-52","source":"upstream_code"},"name":"filter_mode","resource":"main","risk":"R1","type":"string"},{"description":"Auto-zero tracking p06","limit":{"allowed":["on","off"],"ref":"src/sartoriuslib/registry/modes.py:96-101","source":"upstream_code"},"name":"auto_zero","resource":"main","risk":"R1","type":"string"},{"description":"isoCAL mode p15","limit":{"allowed":["off","note","on"],"ref":"src/sartoriuslib/registry/modes.py:135-145","source":"upstream_code"},"name":"isocal_mode","resource":"main","risk":"R1","type":"string"},{"description":"Tare-on-stability behavior p05","limit":{"allowed":["without_stability","with_stability","at_stability"],"ref":"src/sartoriuslib/registry/modes.py:87-93","source":"upstream_code"},"name":"tare_behavior","resource":"main","risk":"R1","type":"string"},{"description":"Front-panel menu access p40","limit":{"allowed":["can_edit","read_only"],"ref":"src/sartoriuslib/registry/modes.py:197-202","source":"upstream_code"},"name":"menu_access","resource":"main","risk":"R1","type":"string"}],"device":{"id":"mhs://localhost/sartorius-balance","kind":"instrument.balance","mode":"hardware","model":"Sartorius balance (sartoriuslib Balance facade)","name":"Sartorius balance via sartoriuslib","risk":"R1","upstream":{"commit":"52f520767051ecee5af2ef5339e1cddc5c406a60","repo":"https://github.com/graysonbellamy/sartoriuslib"},"vendor":"Sartorius"},"facts":[{"ref":"src/sartoriuslib/devices/balance.py:300-308","reviewed_by":null,"source":"upstream_code","text":"Balance is the protocol-neutral facade; construct it via sartoriuslib.open_device"},{"ref":"src/sartoriuslib/devices/balance.py:408-419","reviewed_by":null,"source":"upstream_code","text":"read_net returns the live net weight as a Reading"},{"ref":"src/sartoriuslib/devices/balance.py:425-428","reviewed_by":null,"source":"upstream_code","text":"read_gross returns the gross weight as a Reading"},{"ref":"src/sartoriuslib/devices/balance.py:434-436","reviewed_by":null,"source":"upstream_code","text":"read_tare_value returns the stored tare value as a Reading"},{"ref":"src/sartoriuslib/devices/balance.py:478-480","reviewed_by":null,"source":"upstream_code","text":"status returns the full status block as a BalanceStatus"},{"ref":"src/sartoriuslib/devices/models.py:42-50","reviewed_by":null,"source":"upstream_code","text":"The status state is one of stable, unstable, overload, underload, off or unknown"},{"ref":"src/sartoriuslib/devices/models.py:62-82","reviewed_by":null,"source":"upstream_code","text":"A Reading carries value, unit and stable; value is None on the off-scale sentinel"},{"ref":"src/sartoriuslib/devices/balance.py:855-878","reviewed_by":null,"source":"upstream_code","text":"get_filter_mode reads p01 and set_filter_mode writes p01"},{"ref":"src/sartoriuslib/devices/balance.py:880-901","reviewed_by":null,"source":"upstream_code","text":"get_display_unit reads p07 and set_display_unit writes p07"},{"ref":"src/sartoriuslib/devices/balance.py:903-919","reviewed_by":null,"source":"upstream_code","text":"get_auto_zero reads p06 and set_auto_zero writes p06"},{"ref":"src/sartoriuslib/devices/balance.py:921-937","reviewed_by":null,"source":"upstream_code","text":"get_isocal_mode reads p15 and set_isocal_mode writes p15"},{"ref":"src/sartoriuslib/devices/balance.py:939-955","reviewed_by":null,"source":"upstream_code","text":"get_tare_behavior reads p05 and set_tare_behavior writes p05"},{"ref":"src/sartoriuslib/devices/balance.py:957-973","reviewed_by":null,"source":"upstream_code","text":"get_menu_access reads p40 and set_menu_access writes p40"},{"ref":"src/sartoriuslib/devices/balance.py:818-836","reviewed_by":null,"source":"upstream_code","text":"The parameter writers require confirm=True"},{"ref":"src/sartoriuslib/registry/modes.py:41-52","reviewed_by":null,"source":"upstream_code","text":"The p01 filter modes are very stable, stable, unstable and very unstable"},{"ref":"src/sartoriuslib/registry/modes.py:87-93","reviewed_by":null,"source":"upstream_code","text":"The p05 tare behaviors are without stability, with stability and at stability"},{"ref":"src/sartoriuslib/registry/modes.py:96-101","reviewed_by":null,"source":"upstream_code","text":"The p06 auto-zero modes are on and off"},{"ref":"src/sartoriuslib/registry/modes.py:135-145","reviewed_by":null,"source":"upstream_code","text":"The p15 isoCAL modes are off, note and on"},{"ref":"src/sartoriuslib/registry/modes.py:197-202","reviewed_by":null,"source":"upstream_code","text":"The p40 menu access modes are can_edit and read_only"},{"ref":"src/sartoriuslib/registry/units.py:36-93","reviewed_by":null,"source":"upstream_code","text":"The p07 display-unit table includes g, kg, mg and µg"},{"ref":"src/sartoriuslib/devices/balance.py:349-351","reviewed_by":null,"source":"upstream_code","text":"close closes the underlying transport and is idempotent"}],"measures":[{"description":"Live net weight in milligrams","name":"net_weight","resource":"main","type":"number","unit":"mg"},{"description":"Gross weight in milligrams","name":"gross_weight","resource":"main","type":"number","unit":"mg"},{"description":"Stored tare value in milligrams","name":"tare_value","resource":"main","type":"number","unit":"mg"},{"description":"True when the last net weight reading is stable","name":"stable","resource":"main","type":"boolean"},{"description":"Weighing state from the status block: stable, unstable, overload, underload, off or unknown","name":"status_state","resource":"main","type":"string"},{"description":"Model string reported by the balance","name":"model","resource":"main","type":"string"},{"description":"Serial or factory number reported by the balance; empty when it reports none","name":"serial","resource":"main","type":"string"},{"description":"Software version reported by the balance; empty when it reports none","name":"software","resource":"main","type":"string"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB1-019"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:8a9ff536286f5d1e77f41a60d903a57aee1c7626dbf9d89bcdc40be9cc3ee879","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"close"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":[],"description":"the balance transport is closed; no further command is sent to the instrument"}},"tags":["balance","weighing","mass","sartorius","xbpi","sbi","asyncio"]}
