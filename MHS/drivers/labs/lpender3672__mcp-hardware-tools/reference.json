{"$schema":"https://mhs.openai4s.org/schema/0.9/reference.schema.json","actions":[{"cancellable":false,"cap_id":"x-cap.lpender3672.set_phase.v1","description":"Set the phase of channel 2 relative to channel 1","inputs":[{"description":"Phase offset in degrees, 0 to 360","limit":{"max":360,"min":0,"ref":"src/hwtools/drivers/joyit/jds6600.py:216","source":"upstream_code","unit":"deg"},"name":"degrees","required":true,"type":"number","unit":"deg"}],"long_running":false,"name":"set_phase","outputs":[{"description":"Phase applied by the device, in whole tenths of a degree","name":"phase_deg","required":true,"type":"number","unit":"deg"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"}],"adjusts":[{"description":"CH1 shape","enum":["SINE","SQUARE","PULSE","TRIANGLE","PARTIAL_SINE","CMOS","DC","HALF_WAVE","FULL_WAVE","POS_STEP","NEG_STEP","NOISE","EXP_RISE","EXP_DECAY","MULTI_TONE","SINC","LORENZ"],"name":"ch1_waveform","resource":"main","risk":"R1","type":"string"},{"description":"CH1 Hz","limit":{"max":15000000,"min":0,"reason":"siggen.py:66","ref":"src/hwtools/drivers/joyit/jds6600.py:85","source":"upstream_code","unit":"Hz"},"name":"ch1_frequency_hz","resource":"main","risk":"R1","type":"number","unit":"Hz"},{"description":"CH1 Vpp","limit":{"max":20,"min":0,"reason":"siggen.py:67","ref":"src/hwtools/drivers/joyit/jds6600.py:86","source":"upstream_code","unit":"V"},"name":"ch1_amplitude_vpp","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH1 DC","limit":{"max":9.99,"min":-9.99,"ref":"src/hwtools/drivers/joyit/jds6600.py:17","source":"upstream_code","unit":"V"},"name":"ch1_offset_v","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH1 duty","limit":{"max":100,"min":0,"ref":"src/hwtools/model/siggen.py:69","source":"upstream_code","unit":"%"},"name":"ch1_duty_pct","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"CH1 on","name":"ch1_enabled","resource":"main","risk":"R1","type":"boolean"},{"description":"CH2 shape","enum":["SINE","SQUARE","PULSE","TRIANGLE","PARTIAL_SINE","CMOS","DC","HALF_WAVE","FULL_WAVE","POS_STEP","NEG_STEP","NOISE","EXP_RISE","EXP_DECAY","MULTI_TONE","SINC","LORENZ"],"name":"ch2_waveform","resource":"main","risk":"R1","type":"string"},{"description":"CH2 Hz","limit":{"max":15000000,"min":0,"reason":"siggen.py:66","ref":"src/hwtools/drivers/joyit/jds6600.py:85","source":"upstream_code","unit":"Hz"},"name":"ch2_frequency_hz","resource":"main","risk":"R1","type":"number","unit":"Hz"},{"description":"CH2 Vpp","limit":{"max":20,"min":0,"reason":"siggen.py:67","ref":"src/hwtools/drivers/joyit/jds6600.py:86","source":"upstream_code","unit":"V"},"name":"ch2_amplitude_vpp","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH2 DC","limit":{"max":9.99,"min":-9.99,"ref":"src/hwtools/drivers/joyit/jds6600.py:17","source":"upstream_code","unit":"V"},"name":"ch2_offset_v","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"CH2 duty","limit":{"max":100,"min":0,"ref":"src/hwtools/model/siggen.py:69","source":"upstream_code","unit":"%"},"name":"ch2_duty_pct","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"CH2 on","name":"ch2_enabled","resource":"main","risk":"R1","type":"boolean"}],"device":{"id":"mhs://localhost/jds6600","kind":"instrument","mode":"hardware","model":"JDS6600-15","name":"Joy-IT JDS6600-15 DDS signal generator","risk":"R1","upstream":{"commit":"e13d9cd83962cc1bb80b3f25f0daa2fce52eb0f5","repo":"https://github.com/lpender3672/mcp-hardware-tools"},"vendor":"Joy-IT"},"facts":[{"ref":"src/hwtools/drivers/joyit/jds6600.py:4-7","reviewed_by":null,"source":"upstream_code","text":"The JDS6600 speaks a 115200 8N1 USB-CDC serial line protocol, one command per line framed ':<op><fn>=<data>.' with CRLF, where 'w' writes and 'r' reads"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:13-15","reviewed_by":null,"source":"upstream_code","text":"Frequency is encoded in centi-Hz with unit code 0 ('round(hz*100)'), so a 1 MHz setting reads 100000000,0"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:16-19","reviewed_by":null,"source":"upstream_code","text":"Amplitude is millivolt peak-to-peak, offset is hundredths of a volt biased so 1000 is 0 V, duty is tenths of a percent and phase is tenths of a degree"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:21-24","reviewed_by":null,"source":"upstream_code","text":"Function code 20 is the shared both-channels output-enable register written as 'a,b'; codes 21/22 waveform, 23/24 frequency, 25/26 amplitude, 27/28 bias, 29/30 duty are per channel, and 31 is the channel-2-versus-channel-1 phase"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:83-87","reviewed_by":null,"source":"upstream_code","text":"The driver's capability table records 15 MHz as the JDS6600-15 frequency maximum, 20 Vpp as the amplitude maximum and 9.99 V as the symmetric offset maximum"},{"ref":"src/hwtools/model/siggen.py:66-69","reviewed_by":null,"source":"upstream_code","text":"The upstream model validates frequency > 0, amplitude >= 0 and duty between 0 and 100 percent"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:51-91","reviewed_by":null,"source":"upstream_code","text":"The JDS6600-15 provides two channels, seventeen built-in waveforms, 60 arbitrary slots of 2048 points with 12-bit codes"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:215-217","reviewed_by":null,"source":"upstream_code","text":"The native set_phase_deg accepts 0 to 360 degrees and rejects anything outside that range"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:251-271","reviewed_by":null,"source":"upstream_code","text":"read_channel queries the waveform, frequency, amplitude, offset, duty and output-enable state of one channel"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:205-213","reviewed_by":null,"source":"upstream_code","text":"enable_output reads the shared output pair, flips only the requested channel's bit and writes it back"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:159-163","reviewed_by":null,"source":"upstream_code","text":"idn reads function codes 00 and 01 and formats JDS6600-<model> SN:<serial>"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:72-79","reviewed_by":null,"source":"upstream_code","text":"The arbitrary-waveform path uses 60 slots of exactly 2048 points with 12-bit codes, and a channel plays slot N as waveform code 100 + N"},{"ref":"src/hwtools/drivers/joyit/jds6600.py:251-271","reviewed_by":null,"source":"upstream_code","text":"When an arbitrary slot is selected, read_channel returns its slot and uses SINE as a don't-care built-in waveform field"}],"measures":[{"description":"Instrument identification from protocol function codes 00 and 01","name":"identification","resource":"main","type":"string"},{"description":"CH1 stored arbitrary slot; 0 means a built-in waveform is selected","name":"ch1_arbitrary_slot","resource":"main","type":"integer"},{"description":"CH2 stored arbitrary slot; 0 means a built-in waveform is selected","name":"ch2_arbitrary_slot","resource":"main","type":"integer"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-11-17","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"retriage-drivers-1-017"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:809ba5125f2e569a70d673f014f6f85e01845dd6d7549da2ad6a9c15b62f2328","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"enable_output"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":[],"description":"both channel output-enable flags read back false after disabling both outputs; the physical signal is not measured"}},"tags":["signal-generator","waveform","dds","serial"]}
