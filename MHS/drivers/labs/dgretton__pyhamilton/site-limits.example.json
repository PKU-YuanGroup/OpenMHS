{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (pyhamilton example)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/pyhamilton": {
      "x-cap.dgretton.aspirate.v1": {
        "volume": {"min": 1, "max": 200, "unit": "uL", "source": "operator",
                   "reason": "example only: a protocol using 200 uL tips; the site supplies the range of its own tips and liquid classes"}
      },
      "x-cap.dgretton.dispense.v1": {
        "volume": {"min": 1, "max": 200, "unit": "uL", "source": "operator",
                   "reason": "example only: a protocol using 200 uL tips; the site supplies the range of its own tips and liquid classes"}
      }
    }
  }
}
