{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Tecan FluentControl driver)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/fluentcontrol": {
      "x-cap.aaronslaff.post_transfer_session.v1": {
        "volume_ul": {
          "min": 0,
          "max": 200,
          "unit": "uL",
          "source": "operator",
          "reason": "example only: a deployment sets the volume range of its tips; the standard 200 uL tip named in FLUENT_CONTROL_README.md:141 is an example, not a device bound"
        }
      }
    }
  }
}
