{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Festo FPosBAPI gantry)",
  "issued_by": {
    "id": "operator:example"
  },
  "devices": {
    "mhs://localhost/festo-gantry": {
      "global_speed": {
        "min": 1,
        "max": 200,
        "unit": "mm/s",
        "source": "operator",
        "reason": "example only: a site sets the speed range its drives and mechanics allow"
      },
      "cap.motion.cartesian_pose.v1": {
        "position.x": {
          "min": 0,
          "max": 800,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: a site sets the X workspace envelope of its gantry"
        },
        "position.y": {
          "min": 0,
          "max": 600,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: a site sets the Y workspace envelope of its gantry"
        },
        "position.z": {
          "min": 0,
          "max": 300,
          "unit": "mm",
          "source": "operator",
          "reason": "example only: a site sets the Z workspace envelope of its gantry"
        }
      }
    }
  }
}
