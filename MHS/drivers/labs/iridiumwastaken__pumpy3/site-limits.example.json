{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (pumpy3 PHD 2000)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/pumpy3-phd2000": {
      "rate": {"min": 1, "max": 6000, "unit": "uL/min", "source": "operator",
