{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (DTMicroscope TEM)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/dtmicroscope": {
      "stage": {
        "min": [-0.001, -0.001, -0.001, -10.0, -10.0],
        "max": [0.001, 0.001, 0.001, 10.0, 10.0],
        "unit": "1",
        "source": "operator",
        "reason": "example only: the site supplies the travel of its holder in the stage position's own unit"
      },
      "beam_position": {
        "min": [-100.0, -100.0],
        "max": [100.0, 100.0],
        "unit": "1",
        "source": "operator",
        "reason": "example only: the site supplies the beam-shift range of its column in the server's own unit"
      }
    }
  }
}
