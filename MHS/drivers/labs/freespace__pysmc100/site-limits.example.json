{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (SMC100 single-axis stage)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/smc100": {
      "x-cap.freespace.move_absolute.v1": {
        "position": {
          "min": 0,
          "max": 25,
          "unit": "mm",
          "source": "operator",
          "reason": "example: the bench stage has a 25 mm working range"
        }
      },
      "x-cap.freespace.move_relative.v1": {
        "distance": {
          "min": -25,
          "max": 25,
          "unit": "mm",
          "source": "operator",
          "reason": "example: a relative move stays inside the 25 mm working range"
        }
      }
    }
  }
}
