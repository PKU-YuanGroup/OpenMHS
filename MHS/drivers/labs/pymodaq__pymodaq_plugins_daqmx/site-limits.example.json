{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (pymodaq_plugins_daqmx driver)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/nidaqmx": {
      "analog_output": {
        "min": -10,
        "max": 10,
        "unit": "V",
