{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (New Focus Picomotor controller)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/picomotor": {
      "x-cap.bdhammel.move_steps.v1": {
        "axis": {"min": 1, "max": 4, "unit": "1", "source": "operator",
                 "reason": "example: this unit drives the four motor channels the connect check polls"},
        "steps": {"min": -1000, "max": 1000, "unit": "1", "source": "operator",
                  "reason": "example: keep each relative move within one thousand motor steps on this bench"}
      }
    }
  }
}
