{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (liquid-handling x-axis)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/lhr-x-axis": {
      "x-cap.ethanjli.axis_move.v1": {
        "delta_cm": {"min": -1.0, "max": 1.0, "unit": "cm", "source": "operator",
                     "reason": "example: the bench fixture allows 1 cm of relative travel in either direction"}
      }
    }
  }
}
