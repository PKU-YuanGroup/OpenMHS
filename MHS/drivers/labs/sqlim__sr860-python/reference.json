{"$schema":"https://openmhs.invalid/schema/0.9/reference.schema.json","actions":[],"adjusts":[{"description":"Reference frequency","limit":{"max":500000,"min":0.001,"ref":"srs/sr860.py:80","source":"upstream_code","unit":"Hz"},"name":"frequency","resource":"main","risk":"R1","type":"number","unit":"Hz"},{"description":"Sine output amplitude","limit":{"max":2,"min":1e-9,"ref":"srs/sr860.py:201","source":"upstream_code","unit":"V"},"name":"amplitude","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Reference phase","limit":{"max":360000,"min":-360000,"ref":"srs/sr860.py:231","source":"upstream_code","unit":"deg"},"name":"phase","resource":"main","risk":"R1","type":"number","unit":"deg"},{"description":"Sine output DC offset","limit":{"max":5,"min":-5,"ref":"srs/sr860.py:261","source":"upstream_code","unit":"V"},"name":"dc_offset","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Reference harmonic","limit":{"max":99,"min":1,"ref":"srs/sr860.py:291","source":"upstream_code","unit":"1"},"name":"harmonic","resource":"main","risk":"R1","type":"integer","unit":"1"},{"description":"Filter time constant (OFLT index)","limit":{"allowed":[0.000001,0.000003,0.00001,0.00003,0.0001,0.0003,0.001,0.003,0.01,0.03,0.1,0.3,1,3,10,30,100,300,1000,3000,10000,30000],"ref":"srs/sr860.py:559","source":"upstream_code","unit":"s"},"name":"time_constant","resource":"main","risk":"R1","type":"number","unit":"s"},{"description":"Sync filter enabled","name":"sync_filter_enable","resource":"main","risk":"R1","type":"boolean"},{"description":"Advanced filter enabled","name":"adv_filter_enable","resource":"main","risk":"R1","type":"boolean"},{"description":"X offset (%)","limit":{"max":999.99,"min":-999.99,"ref":"srs/sr860.py:798","source":"upstream_code","unit":"%"},"name":"x_offset","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"Y offset (%)","limit":{"max":999.99,"min":-999.99,"ref":"srs/sr860.py:798","source":"upstream_code","unit":"%"},"name":"y_offset","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"R offset (%)","limit":{"max":999.99,"min":-999.99,"ref":"srs/sr860.py:798","source":"upstream_code","unit":"%"},"name":"r_offset","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"X offset enabled","name":"x_offset_enable","resource":"main","risk":"R1","type":"boolean"},{"description":"Y offset enabled","name":"y_offset_enable","resource":"main","risk":"R1","type":"boolean"},{"description":"R offset enabled","name":"r_offset_enable","resource":"main","risk":"R1","type":"boolean"}],"device":{"id":"mhs://localhost/sr860","kind":"instrument","mode":"hardware","model":"SR860/SR865/SR865A DSP lock-in amplifier","name":"Stanford Research Systems SR860 DSP lock-in amplifier","risk":"R1","upstream":{"commit":"00fa066450759cfa994b1e999eeec7074bc5724c","repo":"https://github.com/sqlim/sr860-python"},"vendor":"Stanford Research Systems"},"facts":[{"ref":"srs/sr860.py:11","reviewed_by":null,"source":"upstream_code","text":"A setting is written as its command word and a formatted value and read back with the same word plus '?' (for example 'FREQ {:.3f}' and 'FREQ?')."},{"ref":"srs/sr860.py:132-134","reviewed_by":null,"source":"upstream_code","text":"The *IDN? reply is comma separated and the second field is the model used to choose the frequency range."},{"ref":"srs/sr860.py:80-84","reviewed_by":null,"source":"upstream_code","text":"The SR860 frequency range is 0.001 Hz to 500 kHz with 1 mHz resolution; the SR865 range is 0.001 Hz to 2 MHz and the SR865A range is 0.001 Hz to 4 MHz."},{"ref":"srs/sr860.py:201","reviewed_by":null,"source":"upstream_code","text":"The sine output amplitude range is 1e-9 V to 2.0 V."},{"ref":"srs/sr860.py:231","reviewed_by":null,"source":"upstream_code","text":"The reference phase range is -360000 to 360000 degrees."},{"ref":"srs/sr860.py:261","reviewed_by":null,"source":"upstream_code","text":"The sine output DC offset range is -5.0 V to 5.0 V."},{"ref":"srs/sr860.py:291","reviewed_by":null,"source":"upstream_code","text":"The harmonic number range is 1 to 99."},{"ref":"srs/sr860.py:559","reviewed_by":null,"source":"upstream_code","text":"The time constants are the 22 values 1e-6, 3e-6, 1e-5, 3e-5 and so on up to 30000 s."},{"ref":"srs/sr860.py:798","reviewed_by":null,"source":"upstream_code","text":"The X, Y and R offsets are percentages in the range -999.99% to 999.99%."},{"ref":"srs/sr860.py:50-52","reviewed_by":null,"source":"upstream_code","text":"The offset enables are written with 'COFA n, value' and read with 'COFA? n' for n = 0 (X), 1 (Y) and 2 (R)."},{"ref":"srs/sr860.py:27","reviewed_by":null,"source":"upstream_code","text":"The advanced filter is written with ADVFILT and read with ADVFILT?."},{"ref":"srs/sr860.py:62-65","reviewed_by":null,"source":"upstream_code","text":"X, Y, R and P are read with OUTP? 0, OUTP? 1, OUTP? 2 and OUTP? 3."},{"ref":"srs/sr860.py:1020","reviewed_by":null,"source":"upstream_code","text":"The X data output is in volts."},{"ref":"srs/sr860.py:1044","reviewed_by":null,"source":"upstream_code","text":"The P data output is in degrees."},{"ref":"srs/sr860.py:88-112","reviewed_by":null,"source":"upstream_code","text":"init() writes a known state: 1 kHz frequency, 1 V amplitude, 0 phase, 0 DC offset, harmonic 1, AC coupling, 24 dB/oct filter and the sync filter on."}],"measures":[{"description":"Time-constant index (OFLT?)","name":"time_constant_index","resource":"main","type":"integer","unit":"1"},{"description":"In-phase signal component (OUTP? 0)","name":"x","resource":"main","type":"number","unit":"V"},{"description":"Quadrature signal component (OUTP? 1)","name":"y","resource":"main","type":"number","unit":"V"},{"description":"Signal magnitude (OUTP? 2)","name":"r","resource":"main","type":"number","unit":"V"},{"description":"Signal phase P relative to the reference (OUTP? 3)","name":"theta","resource":"main","type":"number","unit":"deg"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB2-142"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:29b54b912d0f2d91b7b6161d433c8d79d124ec89be163d3bc5dcf6a95cfcd310","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"SLVL 0.000000001"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":[],"description":"sine output amplitude set to its lowest stated value, 1e-9 V"}},"tags":["lock-in amplifier","sr860","sr865","sr865a","scpi"]}
