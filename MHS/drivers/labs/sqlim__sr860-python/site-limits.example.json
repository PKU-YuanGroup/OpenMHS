{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (sqlim/sr860-python)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/sr860": {
      "frequency": {"min": 1, "max": 100000, "unit": "Hz", "source": "operator",
                    "reason": "example bench limit"},
      "amplitude": {"max": 0.1, "unit": "V", "source": "operator",
                    "reason": "example bench limit"},
      "time_constant": {"allowed": [0.001, 0.003, 0.01, 0.03, 0.1, 0.3, 1.0, 3.0], "source": "operator",
                        "reason": "example bench limit"}
    }
  }
}
