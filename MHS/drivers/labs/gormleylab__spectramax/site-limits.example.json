{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (spectramax)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/spectramax": {
      "x-cap.gormleylab.set_incubator_temperature.v1": {
        "target_temperature": {
          "min": 0,
          "max": 37,
          "unit": "Cel",
          "source": "operator",
          "reason": "example only: the README uses 37 Cel and 0 turns the incubator off (README.md:188-195); a site supplies the true range of its unit, the clone states none"
        }
      }
    }
  }
}
