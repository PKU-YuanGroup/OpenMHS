{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (tektronix serial DAQ)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/tds3052": {
      "ch1_scale": {"min": 0.01, "max": 5.0, "unit": "V", "source": "operator",
                    "reason": "example: bench range 10 mV to 5 V"},
      "ch2_scale": {"min": 0.01, "max": 5.0, "unit": "V", "source": "operator",
                    "reason": "example: bench range 10 mV to 5 V"},
      "horizontal_scale": {"min": 1e-08, "max": 1.0, "unit": "s", "source": "operator",
                           "reason": "example: bench range 10 ns to 1 s"},
      "trigger_level": {"min": -10.0, "max": 10.0, "unit": "V", "source": "operator",
                        "reason": "example: bench range -10 V to 10 V"},
      "trigger_position": {"min": 0.0, "max": 100.0, "unit": "%", "source": "operator",
                           "reason": "example: bench range 0 to 100 %"}
    }
  }
}
