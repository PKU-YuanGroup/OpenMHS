{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (py6632b)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/py6632b": {
      "x-cap.tipith.set_source.v1": {
        "voltage_v": {"min": 0, "max": 5, "unit": "V", "source": "operator",
                      "reason": "example only: the load on this bench accepts at most 5 V"},
        "current_ma": {"min": 0, "max": 100, "unit": "mA", "source": "operator",
                       "reason": "example only: the load on this bench accepts at most 100 mA"}
      }
    }
  }
}
