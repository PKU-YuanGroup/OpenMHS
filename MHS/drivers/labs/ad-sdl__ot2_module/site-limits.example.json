{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Opentrons OT-2 driver)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/ot2": {
      "x-cap.ad-sdl.start_protocol.v1": {
        "protocol_path": {
          "allowed": ["/srv/ot2/protocols/example_protocol.py"],
          "source": "operator",
          "reason": "example only: a deployment lists the protocol files its operator reviewed for this robot, deck and samples; it is not a statement about any protocol"
        }
      }
    }
  }
}
