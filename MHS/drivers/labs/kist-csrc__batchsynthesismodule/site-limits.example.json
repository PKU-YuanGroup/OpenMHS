{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (IKA RET control-visc)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/ika-ret-control-visc": {
      "hot_plate_setpoint": {"min": 20, "max": 200, "unit": "Cel", "source": "operator",
                             "reason": "example: the glassware on this hot plate tolerates 20 to 200 Cel"},
      "cap.thermal.setpoint.v1": {
        "target_temperature": {"min": 20, "max": 200, "unit": "Cel", "source": "operator",
                               "reason": "example: the medium in this setup tolerates 20 to 200 Cel"}
      }
    }
  }
}
