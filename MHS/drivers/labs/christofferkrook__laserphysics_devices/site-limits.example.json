{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Ando AQ-6315A)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/ando-osa": {
      "start_wl": {"min": 400, "max": 1700, "unit": "nm", "source": "operator",
                   "reason": "example: the sweep range used on this bench"},
