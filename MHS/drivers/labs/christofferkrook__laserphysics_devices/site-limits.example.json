      "span": {"min": 0.1, "max": 1300, "unit": "nm", "source": "operator",
               "reason": "example: the sweep range used on this bench"},
      "averages": {"min": 1, "max": 100, "unit": "1", "source": "operator",
                   "reason": "example: average counts used on this bench"}
    }
  }
