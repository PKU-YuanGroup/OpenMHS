{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (Runze SY01B)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/runze-sy01b": {
      "x-cap.allenneuraldynamics.runze_aspirate.v1": {
        "volume": {"min": 0, "max": 5000, "unit": "uL", "source": "operator",
                   "reason": "example: the fitted syringe and the liquid path of this bench hold at most 5000 uL"}
      },
      "x-cap.allenneuraldynamics.runze_dispense.v1": {
        "volume": {"min": 0, "max": 5000, "unit": "uL", "source": "operator",
                   "reason": "example: the fitted syringe and the liquid path of this bench hold at most 5000 uL"}
      },
      "x-cap.allenneuraldynamics.runze_select_valve_port.v1": {
        "port": {"min": 1, "max": 12, "unit": "1", "source": "operator",
                 "reason": "example: this valve is fitted with twelve ports; a six- or nine-port valve narrows it"}
      }
    }
  }
}
