{"$schema":"https://openmhs.invalid/schema/0.9/reference.schema.json","actions":[{"cancellable":false,"cap_id":"x-cap.little-did-i-know.identify.v1","description":"Read the instrument identity","inputs":[],"long_running":false,"name":"identify","outputs":[{"description":"Reply to *IDN?","name":"identity","required":true,"type":"string"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.little-did-i-know.measure_voltage.v1","description":"Measure output 1 voltage","inputs":[],"long_running":false,"name":"measure_voltage","outputs":[{"description":"Measured output 1 voltage","name":"voltage","required":true,"type":"number","unit":"V"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"},{"cancellable":false,"cap_id":"x-cap.little-did-i-know.measure_current.v1","description":"Measure output 1 current","inputs":[],"long_running":false,"name":"measure_current","outputs":[{"description":"Measured output 1 current","name":"current","required":true,"type":"number","unit":"A"}],"requires_permit":false,"resource":"main","risk":"R1","status":"extension","verb":"invoke"}],"adjusts":[{"description":"Output 1 voltage setpoint (CH1:VOLT)","limit":{"max":30,"min":0,"reason":"the SPD3303X output 1 is rated 30 V (psu_models.py:77); the setter accepts 0 through max_voltage (power_supply_output.py:76)","ref":"scpi_control/psu_models.py:77","source":"upstream_code","unit":"V"},"name":"voltage","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Output 1 current limit (CH1:CURR)","limit":{"max":3,"min":0,"reason":"the SPD3303X output 1 is rated 3 A (psu_models.py:77); the setter accepts 0 through max_current (power_supply_output.py:116)","ref":"scpi_control/psu_models.py:77","source":"upstream_code","unit":"A"},"name":"current","resource":"main","risk":"R1","type":"number","unit":"A"},{"description":"Tracking mode: 0 independent, 1 series, 2 parallel (OUTP:TRACK)","enum":[0,1,2],"limit":{"allowed":[0,1,2],"reason":"the wire values are 0 independent, 1 series and 2 parallel","ref":"scpi_control/psu_scpi_commands.py:151","source":"upstream_code","unit":"1"},"name":"tracking","resource":"main","risk":"R1","type":"integer","unit":"1"}],"device":{"id":"mhs://localhost/spd3303x","kind":"instrument","mode":"hardware","model":"SPD3303X / SPD3303X-E","name":"Siglent SPD3303X programmable power supply","risk":"R1","upstream":{"commit":"e252a04dd33d57a543f5a65280cadfbaa634a4a5","repo":"https://github.com/little-did-i-know/scpi-instrument-control"},"vendor":"Siglent"},"facts":[{"ref":"scpi_control/power_supply.py:3-4","reviewed_by":null,"source":"upstream_code","text":"The package controls generic SCPI-99 power supplies and Siglent SPD series models"},{"ref":"scpi_control/power_supply.py:35","reviewed_by":null,"source":"upstream_code","text":"PowerSupply is the power-supply entry class and creates its outputs after connect"},{"ref":"scpi_control/psu_models.py:77-78","reviewed_by":null,"source":"upstream_code","text":"The SPD3303X and SPD3303X-E outputs 1 and 2 are rated 30 V and 3 A"},{"ref":"scpi_control/power_supply_output.py:76","reviewed_by":null,"source":"upstream_code","text":"A voltage setpoint is accepted only when 0 <= volts <= max_voltage"},{"ref":"scpi_control/power_supply_output.py:116","reviewed_by":null,"source":"upstream_code","text":"A current setpoint is accepted only when 0 <= amps <= max_current"},{"ref":"scpi_control/psu_scpi_commands.py:96-99","reviewed_by":null,"source":"upstream_code","text":"The Siglent setpoint commands are CH{ch}:VOLT and CH{ch}:CURR"},{"ref":"scpi_control/psu_scpi_commands.py:183","reviewed_by":null,"source":"upstream_code","text":"A voltage setting is sent as 'CH1:VOLT 5.0'"},{"ref":"scpi_control/psu_scpi_commands.py:103-105","reviewed_by":null,"source":"upstream_code","text":"The Siglent measurement commands are MEASure:VOLTage? CH{ch} and MEASure:CURRent? CH{ch}"},{"ref":"scpi_control/psu_scpi_commands.py:107","reviewed_by":null,"source":"upstream_code","text":"The Siglent output command is OUTPut CH{ch},{ON|OFF}"},{"ref":"scpi_control/psu_scpi_commands.py:140-151","reviewed_by":null,"source":"upstream_code","text":"Tracking is sent as OUTP:TRACK {mode} with the numeric wire values 0 independent, 1 series, 2 parallel"},{"ref":"scpi_control/power_supply.py:196-205","reviewed_by":null,"source":"upstream_code","text":"The identity example is 'Siglent Technologies,SPD3303X,SPD3XXXXXXXXXXX,V1.01' and *IDN? returns it"},{"ref":"scpi_control/power_supply.py:219-225","reviewed_by":null,"source":"upstream_code","text":"SYST:ERR? reads the error queue"},{"ref":"scpi_control/power_supply.py:207-213","reviewed_by":null,"source":"upstream_code","text":"reset() writes *RST and turns off all outputs"}],"measures":[{"description":"Measured output 1 voltage (MEASure:VOLTage? CH1)","name":"measured_voltage","resource":"main","type":"number","unit":"V"},{"description":"Measured output 1 current (MEASure:CURRent? CH1)","name":"measured_current","resource":"main","type":"number","unit":"A"},{"description":"Reply to *IDN?","name":"identity","resource":"main","type":"string"},{"description":"Head of the SYST:ERR? error queue","name":"last_error","resource":"main","type":"string"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB1-003"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:2f8a13f81d263157f32df46a4705ca929cbdfd4f7f052c5f2ed4565825a96b85","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"OUTPut CH1,OFF"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":[],"description":"outputs 1 and 2 switched off (OUTPut CH1,OFF and OUTPut CH2,OFF)"}},"tags":["power 