{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (tektronix-func-gen)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/tektronix-afg": {
      "amplitude_ch1": {"min": 0.02, "max": 10, "unit": "V", "source": "operator",
                        "reason": "example bench envelope"},
      "amplitude_ch2": {"min": 0.02, "max": 10, "unit": "V", "source": "operator",
                        "reason": "example bench envelope"},
      "offset_ch1": {"min": -5, "max": 5, "unit": "V", "source": "operator",
                     "reason": "example bench envelope"},
      "offset_ch2": {"min": -5, "max": 5, "unit": "V", "source": "operator",
                     "reason": "example bench envelope"},
      "frequency_ch1": {"min": 1, "max": 1000000, "unit": "Hz", "source": "operator",
                        "reason": "example bench envelope"},
      "frequency_ch2": {"min": 1, "max": 1000000, "unit": "Hz", "source": "operator",
                        "reason": "example bench envelope"}
    }
  }
}
