devices/afg2225.py:79","source":"upstream_code","unit":"%"},"name":"ch2_duty","resource":"main","risk":"R1","type":"number","unit":"%"},{"description":"Sym","limit":{"max":100,"min":0,"ref":"src/test_engine/devices/afg2225.py:86","source":"upstream_code","unit":"%"},"name":"ch2_sym","resource":"main","risk":"R1","type":"number","unit":"%"}],"device":{"id":"mhs://localhost/afg2225","kind":"instrument","mode":"hardware","model":"AFG-2225","name":"GW Instek AFG-2225 arbitrary function generator","risk":"R1","upstream":{"commit":"59499fa8b568d977aa5e2d5f1144725ee7f3cb0f","repo":"https://github.com/ilovebacteria/test-instrument-automation-open-version"},"vendor":"GW Instek"},"facts":[{"ref":"src/test_engine/devices/afg2225.py:90-97","reviewed_by":null,"source":"upstream_code","text":"AFG2225 is a two-channel function generator whose channel attributes ch1 and ch2 are AFG2225Channel creators"},{"ref":"src/test_engine/devices/afg2225.py:18-30","reviewed_by":null,"source":"upstream_code","text":"The channel shape control writes SOURce{ch}:FUNCtion using the SHAPES map: sine, square, ramp, pulse, noise and user"},{"ref":"src/test_engine/devices/afg2225.py:32-37","reviewed_by":null,"source":"upstream_code","text":"The channel frequency control is in Hz and its strict_range accepts 1e-6 to 25e6"},{"ref":"src/test_engine/devices/afg2225.py:39-44","reviewed_by":null,"source":"upstream_code","text":"The channel amplitude control is peak-to-peak volts and its strict_range accepts 0.001 to 10.0"},{"ref":"src/test_engine/devices/afg2225.py:46-49","reviewed_by":null,"source":"upstream_code","text":"The channel DC offset control is in volts and the clone states no offset range"},{"ref":"src/test_engine/devices/afg2225.py:51-56","reviewed_by":null,"source":"upstream_code","text":"The channel phase control is in degrees and its strict_range accepts -360 to 360"},{"ref":"src/test_engine/devices/afg2225.py:58-65","reviewed_by":null,"source":"upstream_code","text":"The channel output_enabled control reads OUTPut{ch}? and writes OUTPut{ch} ON or OFF"},{"ref":"src/test_engine/devices/afg2225.py:22","reviewed_by":null,"source":"upstream_code","text":"The LOADS map defines the load keys 50ohm and highZ"},{"ref":"src/test_engine/devices/afg2225.py:67-73","reviewed_by":null,"source":"upstream_code","text":"The channel load control reads OUTPut{ch}:LOAD? and writes OUTPut{ch}:LOAD"},{"ref":"src/test_engine/devices/afg2225.py:75-80","reviewed_by":null,"source":"upstream_code","text":"The channel duty-cycle control is percent and its strict_range accepts 1.0 to 99.0"},{"ref":"src/test_engine/devices/afg2225.py:82-87","reviewed_by":null,"source":"upstream_code","text":"The channel ramp-symmetry control is percent and its strict_range accepts 0 to 100"},{"ref":"src/test_engine/devices/afg2225.py:156-162","reviewed_by":null,"source":"upstream_code","text":"sync_phase writes SOURce1:PHASe:SYNChronize"},{"ref":"src/test_engine/devices/afg2225.py:172-175","reviewed_by":null,"source":"upstream_code","text":"The error measurement reads SYSTem:ERRor?"},{"ref":"src/test_engine/devices/afg2225.py:126-128","reviewed_by":null,"source":"upstream_code","text":"The upstream write method sleeps 0.5 s before every command"},{"ref":"src/test_engine/devices/afg2225.py:113-124","reviewed_by":null,"source":"upstream_code","text":"setup() resets the instrument, sleeps 2 s, clears it and enables the OPC and status-byte summary; reset() writes *RST"}],"measures":[{"description":"CH1 DC offset","name":"ch1_offset_v","resource":"main","type":"number","unit":"V"},{"description":"CH2 DC offset","name":"ch2_offset_v","resource":"main","type":"number","unit":"V"},{"description":"Error queue","name":"last_error","resource":"main","type":"string"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-11-17","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"retriage-drivers-1-034"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:6522b788ad256c83f419606bd2f03875abbb168c04d4dd799e99123111743e2c","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"latency_ms":5000,"native":"output_enabled"},"interlocks":[],"not_certified":true,"operator_required":[{"name":"set_offset","path":"offset_v","reason":"no text of the clone states a DC offset range: the upstream offset control names only its unit (V) and validates no envelope (afg2225.py:46-49); the site sets the offset envelope of its unit"}],"safe_state":{"achieved_by":[],"description":"both channel outputs read back as off after OUTPut1 OFF and OUTPut2 OFF"}},"tags":["signal-generator","waveform","function-generator","scpi","pymeasure"]}
