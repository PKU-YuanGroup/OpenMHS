{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (python-oceanoptics TEC)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/oceanoptics-tec": {
      "setpoint": {"min": -40, "max": 0, "unit": "Cel", "source": "operator",
                   "reason": "example: the installed detector and its window tolerate -40 to 0 Cel"},
      "cap.thermal.setpoint.v1": {
        "target_temperature": {"min": -40, "max": 0, "unit": "Cel", "source": "operator",
                               "reason": "example: the installed detector and its window tolerate -40 to 0 Cel"}
      }
    }
  }
}
