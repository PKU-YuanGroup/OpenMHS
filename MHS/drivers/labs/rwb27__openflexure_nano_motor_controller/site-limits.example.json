{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (OpenFlexure stage)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/openflexure-stage": {
      "x-cap.rwb27.move_relative.v1": {
        "displacement": {"min": -1000, "max": 1000, "unit": "step", "source": "operator",
                         "reason": "example only: the operator sets the real travel envelope of this stage"}
      },
      "x-cap.rwb27.move_absolute.v1": {
        "target_position": {"min": -1000, "max": 1000, "unit": "step", "source": "operator",
                            "reason": "example only: the operator sets the real travel envelope of this stage"}
      },
      "x-cap.rwb27.focus_relative.v1": {
        "z": {"min": -1000, "max": 1000, "unit": "step", "source": "operator",
              "reason": "example only: the operator sets the real focus travel of this stage"}
      }
    }
  }
}
