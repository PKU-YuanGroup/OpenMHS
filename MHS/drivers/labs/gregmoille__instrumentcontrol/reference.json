{"$schema":"https://openmhs.invalid/schema/0.9/reference.schema.json","actions":[],"adjusts":[{"description":"Acquisition mode (ACQ:MOD)","limit":{"allowed":["SAM","PEAK","HIR","AVE","WFMDB","ENV"],"ref":"pyScope/PyTektronixScope.py:61-66","source":"upstream_code"},"name":"acquisition_mode","resource":"main","risk":"R1","type":"string"},{"description":"Minimum samples in a WfmDB waveform (ACQ:NUMSAM)","limit":{"max":2147400000,"min":5000,"reason":"the ACQ:NUMSAM docstring states 5,000 to 2,147,400,000 samples","ref":"pyScope/PyTektronixScope.py:720-721","source":"upstream_code","unit":"1"},"name":"acquisition_num_samples","resource":"main","risk":"R1","type":"integer","unit":"1"},{"description":"Sampling mode (ACQ:SAMP)","limit":{"allowed":["RT","ET","IT"],"ref":"pyScope/PyTektronixScope.py:97-99","source":"upstream_code"},"name":"acquisition_sampling_mode","resource":"main","risk":"R1","type":"string"},{"description":"Acquisition state (ACQ:STATE)","limit":{"allowed":["ON","OFF","RUN","STOP"],"ref":"pyScope/PyTektronixScope.py:75-78","source":"upstream_code"},"name":"acquisition_state","resource":"main","risk":"R1","type":"string"},{"description":"Acquire continuously or one sequence (ACQ:STOPA)","limit":{"allowed":["RUNST","SEQ"],"ref":"pyScope/PyTektronixScope.py:87-88","source":"upstream_code"},"name":"acquisition_stop_after","resource":"main","risk":"R1","type":"string"},{"description":"Enhanced ENOB setting (ACQ:ENHANCEDE)","limit":{"allowed":["AUTO","OFF"],"ref":"pyScope/PyTektronixScope.py:659","source":"upstream_code"},"name":"acquisition_enhanced_enob","resource":"main","risk":"R1","type":"string"},{"description":"Enhanced ENOB enabled (ACQ:ENHANCEDE:STATE)","limit":{"allowed":[true,false],"ref":"pyScope/PyTektronixScope.py:665-666","source":"upstream_code"},"name":"acquisition_enhanced_state","resource":"main","risk":"R1","type":"boolean"},{"description":"8-bit interpolation setting (ACQ:INTERPE)","limit":{"allowed":["AUTO","ON","OFF"],"ref":"pyScope/PyTektronixScope.py:673","source":"upstream_code"},"name":"acquisition_interp_8bit","resource":"main","risk":"R1","type":"string"},{"description":"MagniVu acquisition enabled (ACQ:MAG)","limit":{"allowed":[true,false],"ref":"pyScope/PyTektronixScope.py:677","source":"upstream_code"},"name":"acquisition_magnivu","resource":"main","risk":"R1","type":"boolean"}],"device":{"id":"mhs://localhost/tek-dpo70000","kind":"instrument","mode":"hardware","model":"DPO70000 series oscilloscope","name":"Tektronix DPO70000 oscilloscope","risk":"R1","upstream":{"commit":"2cf8c78dea007c636fff1f3d006a039fc1876055","repo":"https://github.com/gregmoille/instrumentcontrol"},"vendor":"Tektronix"},"facts":[{"ref":"pyScope/PyTektronixScope.py:34-35","reviewed_by":null,"source":"upstream_code","text":"TekDPO70000 is the Tektronix DPO70000 series oscilloscope class"},{"ref":"pyScope/PyTektronixScope.py:61-66","reviewed_by":null,"source":"upstream_code","text":"Acquisition modes are SAM, PEAK, HIR, AVE, WFMDB and ENV"},{"ref":"pyScope/PyTektronixScope.py:75-78","reviewed_by":null,"source":"upstream_code","text":"Acquisition states are ON, OFF, RUN and STOP"},{"ref":"pyScope/PyTektronixScope.py:87-88","reviewed_by":null,"source":"upstream_code","text":"Stop-after modes are RUNST and SEQ"},{"ref":"pyScope/PyTektronixScope.py:97-99","reviewed_by":null,"source":"upstream_code","text":"Sampling modes are RT, ET and IT"},{"ref":"pyScope/PyTektronixScope.py:152-156","reviewed_by":null,"source":"upstream_code","text":"Trigger states are ARMED, AUTO, DPO, PARTIAL and READY"},{"ref":"pyScope/PyTektronixScope.py:655-660","reviewed_by":null,"source":"upstream_code","text":"ACQ:ENHANCEDE accepts AUTO and OFF"},{"ref":"pyScope/PyTektronixScope.py:663-667","reviewed_by":null,"source":"upstream_code","text":"ACQ:ENHANCEDE:STATE uses 1 for true and 0 for false"},{"ref":"pyScope/PyTektronixScope.py:669-674","reviewed_by":null,"source":"upstream_code","text":"ACQ:INTERPE accepts AUTO, ON and OFF"},{"ref":"pyScope/PyTektronixScope.py:677","reviewed_by":null,"source":"upstream_code","text":"ACQ:MAG uses ON for true and OFF for false"},{"ref":"pyScope/PyTektronixScope.py:720-721","reviewed_by":null,"source":"upstream_code","text":"The ACQ:NUMSAM range is 5,000 to 2,147,400,000 samples"},{"ref":"pyScope/PyTektronixScope.py:960-970","reviewed_by":null,"source":"upstream_code","text":"run() sends :RUN and stop() sends :STOP"}],"measures":[{"description":"Acquisition mode the instrument reports (ACQ:MOD:ACT)","name":"acquisition_mode_actual","resource":"main","type":"string"},{"description":"Waveform acquisitions since RUN (ACQ:NUMAC)","name":"acquisition_num_acquisitions","resource":"main","type":"integer","unit":"1"},{"description":"Waveform acquisitions averaged (ACQ:NUMAV)","name":"acquisition_num_averages","resource":"main","type":"integer","unit":"1"},{"description":"Waveform acquisitions enveloped (ACQ:NUME)","name":"acquisition_num_envelopes","resource":"main","type":"integer","unit":"1"},{"description":"Frames acquired in FastFrame (ACQ:NUMFRAMESACQ)","name":"acquisition_num_frames","resource":"main","type":"integer","unit":"1"},{"description":"Trigger state (TRIG:STATE)","name":"trigger_state","resource":"main","type":"string"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-29","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wB2-195"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:7c17f15257dbab42a05a332998cfc528a03bd3adf7ba8f4903fde9d8a4fd6e1e","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":":STOP"},"interlocks":[],"not_certified":true,"operator_required":[],"safe_state":{"achieved_by":[],"description":"acquisition stopped (the trigger is disabled)"}},"tags":["oscilloscope","tektronix","dpo70000","scpi"]}
