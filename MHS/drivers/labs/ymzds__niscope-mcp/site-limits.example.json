{
  "$schema": "https://openmhs.invalid/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (niscope-mcp driver)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/niscope": {
      "vertical_offset": {"min": -10, "max": 10, "unit": "V", "source": "operator",
