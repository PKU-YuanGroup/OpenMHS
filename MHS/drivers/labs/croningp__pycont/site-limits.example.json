{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (croningp pycont)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/pycont-pump": {
      "cap.actuation.pump.v1": {
        "flow_rate": {"min": 1, "max": 3000, "unit": "uL/s", "source": "operator",
                      "reason": "example: the tubing and the sample tolerate this flow rate on this pump"},
        "volume": {"min": 0, "max": 5000, "unit": "uL", "source": "operator",
                   "reason": "example: the installed syringe is 5 mL"}
      }
    }
  }
}
