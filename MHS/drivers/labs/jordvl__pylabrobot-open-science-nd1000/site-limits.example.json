{
  "$schema": "https://mhs.openai4s.org/schema/0.9/site-limits.schema.json",
  "openmhs": "0.9",
  "site": "Example bench (NanoDrop 1000 spectrophotometer)",
  "issued_by": {"id": "operator:example"},
  "devices": {
    "mhs://localhost/nanodrop-1000": {
      "cap.measure.spectrum.v1": {
        "wavelength_min": {
          "min": 200,
          "max": 850,
          "unit": "nm",
          "source": "operator",
          "reason": "example only: replace with the wavelength range the site will request from its detector"
        },
        "wavelength_max": {
          "min": 200,
          "max": 850,
          "unit": "nm",
          "source": "operator",
          "reason": "example only: replace with the wavelength range the site will request from its detector"
        }
      }
    }
  }
}
