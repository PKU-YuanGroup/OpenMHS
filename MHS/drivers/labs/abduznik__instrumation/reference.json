,"CHANnel3","CHANnel4","EXT","DEMath"],"ref":"src/instrumation/drivers/rigol.py:323-329","source":"upstream_code"},"name":"edge_trigger_source","resource":"main","risk":"R1","type":"string"},{"description":"Edge trigger slope","limit":{"allowed":["POSITIVE","NEGATIVE","RFALL"],"ref":"src/instrumation/drivers/rigol.py:341-344","source":"upstream_code"},"name":"edge_trigger_slope","resource":"main","risk":"R1","type":"string"},{"description":"Edge trigger level","limit":"operator_required","name":"edge_trigger_level","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Channel 1 display","name":"ch1_display","resource":"main","risk":"R1","type":"boolean"},{"description":"Channel 1 coupling","limit":{"allowed":["AC","DC","GND"],"ref":"src/instrumation/drivers/rigol.py:186-188","source":"upstream_code"},"name":"ch1_coupling","resource":"main","risk":"R1","type":"string"},{"description":"Channel 1 scale, V/div","limit":"operator_required","name":"ch1_scale","resource":"main","risk":"R1","type":"number","unit":"V"},{"description":"Channel 1 bandwidth limit","limit":{"allowed":["20M","OFF"],"ref":"src/instrumation/drivers/rigol.py:249-251","source":"upstream_code"},"name":"ch1_bw_limit","resource":"main","risk":"R1","type":"string"}],"device":{"id":"mhs://localhost/rigol-ds1054z","kind":"instrument","mode":"hardware","model":"DS1054Z","name":"RIGOL DS1054Z oscilloscope","risk":"R1","upstream":{"commit":"483d6d5d0b6984f0e261e340363f784f6e2dd2f8","repo":"https://github.com/abduznik/instrumation"},"vendor":"RIGOL Technologies"},"facts":[{"ref":"docs/experiments/rigol_ds1054z.md:10","reviewed_by":null,"source":"vendor_doc","text":"The DS1054Z is a 50 MHz, 4-channel digital oscilloscope with a 1 GSa/s sample rate"},{"ref":"docs/experiments/rigol_ds1054z.md:3-4","reviewed_by":null,"source":"vendor_doc","text":"The DS1054Z belongs to the MSO1000Z/DS1000Z family"},{"ref":"src/instrumation/drivers/rigol.py:56-61","reviewed_by":null,"source":"upstream_code","text":"The driver supports the MSO1000Z/DS1000Z series and implements edge trigger only"},{"ref":"src/instrumation/drivers/rigol.py:159-161","reviewed_by":null,"source":"upstream_code","text":"The scope has four channels and the driver rejects a channel outside 1..4"},{"ref":"docs/experiments/rigol_ds1054z.md:44","reviewed_by":null,"source":"vendor_doc","text":"Identity is queried with *IDN? and the experiment document prints 'RIGOL,DS1054Z,...'"},{"ref":"src/instrumation/drivers/rigol.py:124-127","reviewed_by":null,"source":"upstream_code","text":"set_acquire_type accepts NORMAL, AVERAGES, PEAK and HRESOLUTION"},{"ref":"src/instrumation/drivers/rigol.py:133-143","reviewed_by":null,"source":"upstream_code","text":"set_acquire_averages accepts powers of two from 2 to 1024 (2^n, n=1..10)"},{"ref":"src/instrumation/drivers/rigol.py:145-151","reviewed_by":null,"source":"upstream_code","text":"The memory depth is given only as examples: 14k, 140k and 14M points, and the experiment document uses 14000000 points"},{"ref":"docs/experiments/rigol_ds1054z.md:51-55","reviewed_by":null,"source":"vendor_doc","text":"The experiment document configures the timebase with 1 ms/div and the trigger level with 1.0 V"},{"ref":"src/instrumation/drivers/rigol.py:186-188","reviewed_by":null,"source":"upstream_code","text":"Channel coupling is AC, DC or GND"},{"ref":"src/instrumation/drivers/rigol.py:249-251","reviewed_by":null,"source":"upstream_code","text":"The bandwidth limit accepts 20M or OFF"},{"ref":"src/instrumation/drivers/rigol.py:323-329","reviewed_by":null,"source":"upstream_code","text":"The edge trigger source list is CHANnel1..CHANnel4, EXT and DEMath"},{"ref":"src/instrumation/drivers/rigol.py:341-344","reviewed_by":null,"source":"upstream_code","text":"The edge trigger slopes are POSITIVE, NEGATIVE and RFALL"},{"ref":"src/instrumation/drivers/rigol.py:362-367","reviewed_by":null,"source":"upstream_code","text":"The trigger sweeps are AUTO, NORMAL and SINGLE"},{"ref":"src/instrumation/drivers/rigol.py:100-114","reviewed_by":null,"source":"upstream_code","text":"run writes :RUN, stop writes :STOP and force_trigger writes :TFORce"},{"ref":"src/instrumation/drivers/rigol.py:560-562","reviewed_by":null,"source":"upstream_code","text":"shutdown_safety stops the acquisition and then synchronises the instrument"}],"measures":[{"description":"Instrument identification returned by *IDN?","name":"identity","resource":"main","type":"string"},{"description":"Current sample rate (:ACQuire:SRATe?)","name":"sample_rate","resource":"main","type":"number","unit":"Hz"},{"description":"Timebase mode, MAIN, XY or ROLL (:TIMebase:MODE?)","name":"timebase_mode","resource":"main","type":"string"},{"description":"Horizontal offset from the trigger point (:TIMebase:OFFSet?)","name":"timebase_offset","resource":"main","type":"number","unit":"s"},{"description":"Trigger mode, EDGE or another mode (:TRIGger:MODE?)","name":"trigger_mode","resource":"main","type":"string"},{"description":"Trigger status such as TD, WAIT, AUTO or STOP","name":"trigger_status","resource":"main","type":"string"},{"description":"Channel 1 vertical offset (:CHANnel1:OFFSet?)","name":"ch1_offset","resource":"main","type":"number","unit":"V"},{"description":"Channel 1 probe attenuation ratio (:CHANnel1:PROBe?)","name":"ch1_probe","resource":"main","type":"number","unit":"1"},{"description":"Channel 1 inversion state (:CHANnel1:INVert?)","name":"ch1_invert","resource":"main","type":"boolean"}],"openmhs":"0.9","overlay":null,"provenance":{"authored_by":{"date":"2026-10-30","kind":"model","model_id":"deepseek-v4.1-flash:1017","run_id":"wP-002"},"catalogue_digest":"sha256:c114376cd58d3ae5c4454dd0ba9b67563b958c195bf1e75c3b8373cd23ab1d0c","generated_by":"mhs.reference_file","manifest_digest":"sha256:10f9494ecc16103818db755b13b8d76827e4da9ccf84b6ce9473bdbdd99ff6e2","reviewed_by":null,"sdk_version":"0.9.0.dev0"},"safety":{"estop":{"kind":"software","latching":true,"native":"stop"},"interlocks":[],"not_certified":true,"operator_required":[{"name":"timebase_scale","reason":"the clone's docstring gives only an example range, 1e-9 to 50.0 s/div (rigol.py:297), not the specification of this unit; the site supplies the timebase range"},{"name":"edge_trigger_level","reason":"the clone states no trigger level range (setter at rigol.py:350-352); the site supplies the range its probe and signal allow"},{"name":"ch1_scale","reason":"the clone's docstring gives only an example, 0.01 to 10.0 V/div (rigol.py:201), not the specification of this unit; the site supplies the scale range of its probe"}],"safe_state":{"achieved_by":["x-cap.abduznik.stop.v1"],"description":"acquisition stopped with :STOP and the trigger held off (the native stop)"}},"tags":["oscilloscope","rigol","ds1054z","ds1000z","scpi","instrument"]}
