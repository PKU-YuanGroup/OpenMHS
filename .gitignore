# OpenMHS: this file is an ALLOWLIST. Everything at the top level is ignored unless it is listed below.
# The research workspace (labs/, robots/, work/, _archive/, _backup/, review material, the OpenAI4S checkout) is
# private input and never part of the open-source repository; tools/oss_export_check.py enforces that.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE-docs
!/NOTICE
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/.github/
!/tools/
!/MHS/
!/integration/

# Generated or local files, wherever they are
__pycache__/
*.py[cod]
.DS_Store
*.egg-info/
build/
dist/
.venv/
.mhs-run/
# written (and timestamped) by every gate run; CI regenerates them
MHS/drivers/**/check-report.json
MHS/sdk/examples/**/check-report.json
